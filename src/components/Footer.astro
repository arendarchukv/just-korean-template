---
import Icon, { type IconName } from '@/components/Icon.astro';
import Logo from '@/components/Logo.astro';
import { SITE } from '@/config';
import { getSite } from '@/content/queries';
import HolidayMotifs from '@/components/holidays/HolidayMotifs.astro';
import { holidayRender } from '@/lib/holiday-logic';
import type { Lang, UIKey } from '@/i18n/ui';
import { localizePath, useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const site = await getSite();

// The site's pages. Grammar is not in the header menu (the owner's wish), so it is reached here.
const LEARN: { path: string; label: UIKey }[] = [
  { path: 'lessons', label: 'nav.lessons' },
  { path: 'grammar', label: 'page.grammar.title' },
  { path: 'materials', label: 'nav.materials' },
  { path: 'practice', label: 'nav.practice' },
];

// Links are edited in Pages CMS (Site settings); empty ones are left out, as the CMS hint says.
const CONNECT: { href: string; label: UIKey; icon: IconName }[] = [
  { href: localizePath(lang, 'classes'), label: 'nav.classes', icon: 'cap' },
  // The Contact page shows her Tally form (or the demo form until it is set).
  { href: localizePath(lang, 'contact'), label: 'footer.contact', icon: 'mail' },
  { href: site.social.kofi, label: 'nav.support', icon: 'cup' },
];

// Her channels as icon buttons under the logo, apart from the page links.
const SOCIAL: { href: string; label: UIKey; icon: IconName }[] = [
  { href: site.social.youtube, label: 'footer.youtube', icon: 'youtube' },
  { href: site.social.instagram, label: 'footer.instagram', icon: 'instagram' },
];

const external = (href: string) =>
  href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {};
const year = new Date().getFullYear();
---

<footer class="site-footer">
  {holidayRender(site.holiday).pieces && <HolidayMotifs kind="echo" class="holiday-footer-echo" />}
  <div class="container-page footer-main" data-print="hide">
    <div class="footer-brand">
      <Logo wordmark class="text-lg" />
      <p class="footer-tagline">{t('site.tagline')}</p>
      <ul class="footer-social">
        {SOCIAL.filter(({ href }) => href).map(({ href, label, icon }) => (
          <li>
            <a href={href} {...external(href)} class="footer-social-link" aria-label={t(label)}>
              <Icon name={icon} />
            </a>
          </li>
        ))}
      </ul>
    </div>

    <nav aria-label={t('a11y.footerNav')} class="footer-nav">
      <div class="footer-group">
        <h2 class="footer-heading">{t('footer.learn')}</h2>
        <ul data-footer-pages>
          {LEARN.map(({ path, label }) => (
            <li>
              <a href={localizePath(lang, path)} class="footer-link">
                {t(label)}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div class="footer-group">
        <h2 class="footer-heading">{t('footer.connect')}</h2>
        <ul>
          {CONNECT.filter(({ href }) => href).map(({ href, label, icon }) => (
            <li>
              <a href={href} {...external(href)} class="footer-link">
                <Icon name={icon} />
                {t(label)}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  </div>
  <div class="container-page footer-bottom">
    <p>
      &copy; {year} {SITE.name}. {t('footer.rights')}
    </p>
  </div>
</footer>
