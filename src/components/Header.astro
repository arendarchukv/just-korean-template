---
import Logo from '@/components/Logo.astro';
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import type { Lang, UIKey } from '@/i18n/ui';
import { getSite } from '@/content/queries';
import { localizePath, stripLocale, useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
  showLanguageSwitch?: boolean;
}

const { lang, showLanguageSwitch = true } = Astro.props;
const t = useTranslations(lang);

const NAV: { path: string; key: UIKey }[] = [
  { path: 'lessons', key: 'nav.lessons' },
  { path: 'materials', key: 'nav.materials' },
  { path: 'practice', key: 'nav.practice' },
  { path: 'classes', key: 'nav.classes' },
];

const current = stripLocale(Astro.url.pathname);
const items = NAV.map((item) => ({
  href: localizePath(lang, item.path),
  label: t(item.key),
  active: current === item.path || current.startsWith(`${item.path}/`),
}));
// Booking opens TidyCal in a new tab; until its link is set, the Classes page.
const tidycal = (await getSite()).tidycal;
const book = tidycal
  ? { href: tidycal, target: '_blank', rel: 'noopener noreferrer' }
  : { href: localizePath(lang, 'classes') };
---

<header class="sticky top-0 z-40 border-b border-border bg-bg/90 backdrop-blur">
  <div class="container-page flex h-16 items-center gap-4">
    <a
      href={localizePath(lang)}
      aria-label={t('a11y.home')}
      class="-ml-1 inline-flex min-h-touch items-center rounded-control px-1 text-xl"
    >
      <Logo wordmark />
    </a>

    <nav aria-label={t('a11y.mainNav')} class="ml-6 hidden lg:block" data-print="hide">
      <ul class="flex items-center gap-1">
        {items.map((item) => (
          <li>
            <a href={item.href} aria-current={item.active ? 'page' : undefined} class="nav-link">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-1" data-print="hide">
      {showLanguageSwitch && <LanguageSwitcher lang={lang} />}
      <ThemeToggle lang={lang} />
      <a {...book} data-book-class class="btn btn-primary ml-2 hidden lg:inline-flex">
        {t('nav.bookClass')}
      </a>

      <!-- Mobile menu: a native disclosure, so it works without JS; the script below adds
           Escape / backdrop to close, scroll lock, and closing when the window widens. -->
      <details class="group lg:hidden" data-mobile-menu>
        <summary class="icon-btn cursor-pointer list-none [&::-webkit-details-marker]:hidden">
          <span class="sr-only">{t('a11y.menu')}</span>
          <svg
            class="size-6 group-open:hidden"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
          <svg
            class="hidden size-6 group-open:block"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </summary>
        <div class="menu-backdrop" data-menu-backdrop aria-hidden="true"></div>
        <nav
          aria-label={t('a11y.mainNav')}
          class="mobile-menu-panel absolute inset-x-0 top-16 z-10 border-b border-border bg-bg shadow-sm"
        >
          <ul class="container-page flex flex-col gap-1 py-4">
            {items.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={item.active ? 'page' : undefined}
                  class="nav-link text-lg text-text hover:bg-surface"
                >
                  {item.label}
                </a>
              </li>
            ))}
            <li class="pt-2">
              <a {...book} data-book-class class="btn btn-primary w-full">
                {t('nav.bookClass')}
              </a>
            </li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('details[data-mobile-menu]');
  if (menu) {
    const summary = menu.querySelector('summary')!;
    const root = document.documentElement;
    const desktop = window.matchMedia('(min-width: 64rem)');
    const close = () => {
      menu.open = false;
    };

    // Scroll lock follows the open state, however the menu was opened or closed.
    const sync = () => root.toggleAttribute('data-menu-open', menu.open);
    menu.addEventListener('toggle', sync);
    sync();

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        close();
        summary.focus();
      }
    });
    menu.querySelector('[data-menu-backdrop]')?.addEventListener('click', close);
    desktop.addEventListener('change', (event) => {
      if (event.matches) close();
    });
  }
</script>
