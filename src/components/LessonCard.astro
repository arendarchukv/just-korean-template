---
import LevelBadge from '@/components/learn/LevelBadge.astro';
/**
 * One lesson as a framed card: thumbnail (fetched and optimised at build; a paper placeholder for
 * a lesson without a video), playlist (with the place in a course) and date, title, then level and "Watch". Home and Lessons.
 */
import { Image } from 'astro:assets';
import { getLessons, type Lesson } from '@/content/queries';
import { playlistText } from '@/data/playlists';
import type { Lang, UIKey } from '@/i18n/ui';
import { dateFormat, localizePath, useTranslations } from '@/i18n/utils';
import { sortInPlaylist } from '@/lib/site-logic';
import { youtubeThumbnail } from '@/lib/youtube';

interface Props {
  lesson: Lesson;
  lang: Lang;
}
const { lesson: l, lang } = Astro.props;
const t = useTranslations(lang);
const dates = dateFormat(lang);
// A course lesson says its place ("Lesson 3") wherever the card is, so a course reads in order.
const course = l.playlistEntry?.kind === 'course' ? l.playlistEntry.id : undefined;
const position = course
  ? sortInPlaylist(
      (await getLessons()).filter((x) => x.playlist === course),
      'course',
    ).findIndex((x) => x.id === l.id) + 1
  : 0;
---

<a class="lesson-card" href={localizePath(lang, `lessons/${l.id}`)}>
  {l.youtube ? (
    <Image
      src={youtubeThumbnail(l.youtube)}
      alt=""
      width={480}
      height={270}
      fit="cover"
      class="lesson-thumb"
    />
  ) : (
    <span class="lesson-thumb lesson-thumb-empty grid-paper">{t('lessons.noVideo')}</span>
  )}
  <span class="lesson-card-body">
    <span class="lesson-meta">
      {l.playlistEntry && `${playlistText(l.playlistEntry, lang).title} · `}
      {position && `${t('lessons.number').replace('{n}', String(position))} · `}
      <time datetime={l.date.toISOString().slice(0, 10)}>{dates.format(l.date)}</time>
    </span>
    <span class="lesson-title">{l.title}</span>
    <span class="lesson-foot">
      <LevelBadge level={l.level} label={t(`grammar.level.${l.level}` as UIKey)} small />
      <span class="lesson-watch" aria-hidden="true">
        {l.youtube ? t('home.newLessons.watch') : t('lessons.read')} →
      </span>
    </span>
  </span>
</a>
