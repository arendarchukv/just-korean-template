---
import {
  LOGO_MARK_PATHS,
  LOGO_MARK_ROUNDED_POLYLINES,
  LOGO_MARK_WIDTH,
} from '@/components/shapes/paths';

/**
 * Just Korean mark: ㄱ + ㄴ rotated 180° against each other, interlocking into an upright block
 * (the proportions of her channel logo).
 * Final variant is TBD:
 *   a — sharp (default), b — rounded (avatars), c — two-tone.
 * Wordmark font is unknown; Outfit 700 for now.
 */
interface Props {
  variant?: 'a' | 'b' | 'c';
  wordmark?: boolean;
  /** Accessible name. Omit when the logo sits inside a labelled link. */
  title?: string;
  class?: string;
}

const { variant = 'a', wordmark = false, title, class: className } = Astro.props;
const a11y = title
  ? { role: 'img' as const, 'aria-label': title }
  : { 'aria-hidden': 'true' as const };
---

<span class:list={['inline-flex items-center gap-2.5 text-logo', className]} {...a11y}>
  <svg
    viewBox={`0 0 ${LOGO_MARK_WIDTH} 100`}
    class="h-[1.75em] w-auto shrink-0"
    xmlns="http://www.w3.org/2000/svg"
  >
    {variant === 'b' ? (
      <g
        fill="none"
        stroke="currentColor"
        stroke-width="20"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        {LOGO_MARK_ROUNDED_POLYLINES.map((points) => (
          <polyline points={points} />
        ))}
      </g>
    ) : (
      <>
        <path d={LOGO_MARK_PATHS[0]} fill="currentColor" />
        <path
          d={LOGO_MARK_PATHS[1]}
          fill={variant === 'c' ? 'var(--color-logo-secondary)' : 'currentColor'}
        />
      </>
    )}
  </svg>
  {wordmark && (
    <span class="flex flex-col font-['Outfit_Variable',sans-serif] text-[0.8em] leading-[0.95] font-bold tracking-tight text-brand">
      <span>Just</span>
      <span>Korean</span>
    </span>
  )}
</span>
