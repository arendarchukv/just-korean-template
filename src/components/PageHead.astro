---
/**
 * Page heading: a small label (eyebrow), the page title (h1) and one line of explanation.
 * The same three steps as SectionHead, one level up; extra content (search, tabs) goes in the slot.
 */
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<div class="container-page page-head">
  <p class="section-eyebrow">{eyebrow}</p>
  <h1 class="page-title">{title}</h1>
  {lead && <p class="page-lead">{lead}</p>}
  <slot />
</div>
