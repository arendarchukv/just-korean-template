---
/**
 * Light / dark switch. The initial theme is applied by ThemeScript in <head> (saved choice,
 * else the OS preference), so there is no flash; this button flips it and saves the choice.
 * Until the visitor clicks, the site keeps following OS changes. The new theme spreads from the
 * click like ink soaking into paper (a view transition; `[data-ink]` in signature.css); without
 * support, or under reduced motion, it switches at once.
 */
import type { Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
---

<button
  type="button"
  class="icon-btn"
  data-theme-toggle
  data-label-to-dark={t('theme.toDark')}
  data-label-to-light={t('theme.toLight')}
  aria-label={t('theme.toDark')}
  title={t('theme.toDark')}
>
  <!-- Shows what a click does: a moon in light mode, a sun in dark mode (CSS, by html[data-theme]). -->
  <svg
    class="theme-icon theme-icon-moon size-5"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z"></path>
  </svg>
  <svg
    class="theme-icon theme-icon-sun size-5"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
  </svg>
</button>

<style is:global>
  .theme-icon {
    display: none;
  }
  html:not([data-theme='dark']) .theme-icon-moon,
  html[data-theme='dark'] .theme-icon-sun {
    display: block;
  }
</style>

<script>
  type Theme = 'light' | 'dark';
  const root = document.documentElement;
  const media = window.matchMedia('(prefers-color-scheme: dark)');

  const current = (): Theme => (root.dataset.theme === 'dark' ? 'dark' : 'light');

  function hasSavedChoice(): boolean {
    try {
      return localStorage.getItem('theme') !== null;
    } catch {
      return false;
    }
  }

  function apply(theme: Theme) {
    root.dataset.theme = theme;
    for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
      const label = (theme === 'dark' ? btn.dataset.labelToLight : btn.dataset.labelToDark) ?? '';
      btn.setAttribute('aria-label', label);
      btn.title = label;
    }
  }

  const still = window.matchMedia('(prefers-reduced-motion: reduce)');

  // The ink starts where the click was; from the keyboard, at the button's centre. The new page
  // shows through a soft-edged round mask that grows over it: Web Animations on the mask's size and
  // position (no custom properties: Firefox does not animate those on view-transition pieces).
  function spread(event: MouseEvent, btn: HTMLElement, change: () => void) {
    if (!document.startViewTransition || still.matches) return change();
    const box = btn.getBoundingClientRect();
    const x = event.detail ? event.clientX : box.left + box.width / 2;
    const y = event.detail ? event.clientY : box.top + box.height / 2;
    // Wide enough to cover the far corner with its soft edge (the last fifth of the radius).
    const size = 2.5 * Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
    root.dataset.ink = '';
    const transition = document.startViewTransition(change);
    transition.ready
      .then(() => {
        const mask = 'radial-gradient(closest-side, #000 80%, transparent)';
        root.animate(
          {
            maskImage: [mask, mask],
            maskRepeat: ['no-repeat', 'no-repeat'],
            maskSize: ['0px 0px', `${size}px ${size}px`],
            maskPosition: [`${x}px ${y}px`, `${x - size / 2}px ${y - size / 2}px`],
          },
          {
            duration: 650,
            easing: 'cubic-bezier(0.2, 0.7, 0.2, 1)',
            fill: 'both',
            pseudoElement: '::view-transition-new(root)',
          },
        );
      })
      .catch(() => {});
    transition.finished.finally(() => delete root.dataset.ink);
  }

  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    btn.addEventListener('click', (event) => {
      const next: Theme = current() === 'dark' ? 'light' : 'dark';
      try {
        localStorage.setItem('theme', next);
      } catch {
        // Storage unavailable (private mode): the theme still applies for this page view.
      }
      spread(event, btn, () => apply(next));
    });
  }

  media.addEventListener('change', () => {
    if (!hasSavedChoice()) apply(media.matches ? 'dark' : 'light');
  });

  apply(current());
</script>
