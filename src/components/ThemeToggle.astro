---
/**
 * Cycles system -> light -> dark. The initial theme is applied by ThemeScript in <head>
 * so there is no flash; this button only changes it.
 */
import type { Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
---

<button
  type="button"
  class="icon-btn"
  data-theme-toggle
  data-label-system={t('theme.system')}
  data-label-light={t('theme.light')}
  data-label-dark={t('theme.dark')}
  aria-label={t('theme.system')}
  title={t('theme.system')}
>
  <!-- Icons are shown by CSS according to html[data-theme-pref]. -->
  <svg
    class="theme-icon theme-icon-system size-5"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <rect x="3" y="4" width="18" height="12" rx="2"></rect>
    <path d="M8 20h8M12 16v4"></path>
  </svg>
  <svg
    class="theme-icon theme-icon-light size-5"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
  </svg>
  <svg
    class="theme-icon theme-icon-dark size-5"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z"></path>
  </svg>
</button>

<style is:global>
  .theme-icon {
    display: none;
  }
  html:not([data-theme-pref]) .theme-icon-system,
  html[data-theme-pref='system'] .theme-icon-system,
  html[data-theme-pref='light'] .theme-icon-light,
  html[data-theme-pref='dark'] .theme-icon-dark {
    display: block;
  }
</style>

<script>
  type Pref = 'system' | 'light' | 'dark';
  const ORDER: Pref[] = ['system', 'light', 'dark'];
  const root = document.documentElement;
  const media = window.matchMedia('(prefers-color-scheme: dark)');

  const currentPref = (): Pref => {
    const p = root.dataset.themePref;
    return p === 'light' || p === 'dark' ? p : 'system';
  };

  function apply(pref: Pref) {
    const dark = pref === 'dark' || (pref === 'system' && media.matches);
    root.dataset.theme = dark ? 'dark' : 'light';
    root.dataset.themePref = pref;
    for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
      const label = btn.dataset[`label${pref[0]!.toUpperCase()}${pref.slice(1)}`] ?? '';
      btn.setAttribute('aria-label', label);
      btn.title = label;
    }
  }

  function save(pref: Pref) {
    try {
      if (pref === 'system') localStorage.removeItem('theme');
      else localStorage.setItem('theme', pref);
    } catch {
      // Storage unavailable (private mode): theme still applies for this page view.
    }
  }

  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    btn.addEventListener('click', () => {
      const next = ORDER[(ORDER.indexOf(currentPref()) + 1) % ORDER.length]!;
      save(next);
      apply(next);
    });
  }

  media.addEventListener('change', () => {
    if (currentPref() === 'system') apply('system');
  });

  apply(currentPref());
</script>
