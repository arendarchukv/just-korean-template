---
import { FORMATS } from '@/data/classes';
import type { Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';

/**
 * Class formats as a ruled timetable, one row per format from src/data/classes.ts. Used on the
 * home page and the Classes page; on phones the rows stack into labelled blocks (home.css).
 */
interface Props {
  lang: Lang;
  /** Id of the heading that names the table. */
  labelledBy: string;
}

const { lang, labelledBy } = Astro.props;
const t = useTranslations(lang);
---

<div class="table-scroll" tabindex="0" role="region" aria-labelledby={labelledBy}>
  <table class="timetable">
    <thead>
      <tr>
        <th scope="col">{t('home.classes.format')}</th>
        <th scope="col">{t('home.classes.forWhom')}</th>
        <th scope="col">{t('home.classes.how')}</th>
      </tr>
    </thead>
    <tbody>
      {FORMATS.map((f) => (
        <tr>
          <th scope="row">{f.name}</th>
          <td data-label={t('home.classes.forWhom')}>{f.forWhom}</td>
          <td data-label={t('home.classes.how')}>{f.how}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
