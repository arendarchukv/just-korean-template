---
/**
 * DEMO ONLY: a temporary switch to preview each holiday's decorations on any page (bottom left).
 * It sets <html data-holiday> for this tab (sessionStorage), over what Site settings decide.
 * English only, styles inline (kept out of the shared stylesheet). Remove before launch.
 */
import { HOLIDAYS } from '@/data/holidays';
---

<div class="holiday-preview" data-holiday-preview data-print="hide">
  <label for="holiday-preview-select">Holiday preview</label>
  <select id="holiday-preview-select">
    <option value="">As in Site settings</option>
    <option value="none">No holiday</option>
    {HOLIDAYS.map((h) => (
      <option value={h.id}>{`${h.korean} · ${h.text.en.name}`}</option>
    ))}
  </select>
</div>

<style is:inline>
  .holiday-preview {
    position: fixed;
    bottom: 1rem;
    left: 1rem;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.5rem 0.4rem 0.75rem;
    border: 1px dashed var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-surface);
    color: var(--color-text);
    font-size: 0.8125rem;
    font-weight: 600;
  }
  /* Out of the way of the open mobile menu and its backdrop. */
  html[data-menu-open] .holiday-preview {
    display: none;
  }
  .holiday-preview select {
    min-height: 2.25rem;
    padding: 0 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-bg);
    color: inherit;
    font: inherit;
  }
</style>

<script is:inline>
  (function () {
    var root = document.documentElement;
    var select = document.getElementById('holiday-preview-select');
    var fromSettings = root.dataset.holiday;
    function apply(value) {
      if (value === 'none') delete root.dataset.holiday;
      else if (value) root.dataset.holiday = value;
      else if (fromSettings) root.dataset.holiday = fromSettings;
      else delete root.dataset.holiday;
    }
    var saved = '';
    try {
      saved = sessionStorage.getItem('jk:holiday-preview') || '';
    } catch (e) {}
    select.value = saved;
    apply(saved);
    select.addEventListener('change', function () {
      try {
        sessionStorage.setItem('jk:holiday-preview', select.value);
      } catch (e) {}
      apply(select.value);
    });
  })();
</script>
