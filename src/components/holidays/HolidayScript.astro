---
/**
 * Inline, render-blocking like ThemeScript: with Site settings on `auto`, sets `data-holiday` on
 * <html> before first paint from the visitor's own day (builds are rare: the date is never decided
 * at build), so holiday pieces never appear late. A holiday chosen by hand needs no script: it is
 * written on <html> at build.
 */
import { holidayWindows } from '@/lib/holiday-logic';

// Compact for the page: [id, from, to] per window.
const windows = holidayWindows().map((w) => [w.id, w.from, w.to]);
---

<script is:inline define:vars={{ windows }}>
  (function () {
    var d = new Date();
    var pad = function (n) {
      return String(n).padStart(2, '0');
    };
    var today = d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
    for (var i = 0; i < windows.length; i++) {
      if (windows[i][1] <= today && today <= windows[i][2]) {
        document.documentElement.dataset.holiday = windows[i][0];
        return;
      }
    }
  })();
</script>
