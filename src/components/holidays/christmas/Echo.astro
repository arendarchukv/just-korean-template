---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<!-- Christmas echo: a four-point star. -->
<svg viewBox="0 0 40 40" class:list={['shape', className]} aria-hidden="true" focusable="false">
  <path
    d="M20 2 L24.5 15.5 L38 20 L24.5 24.5 L20 38 L15.5 24.5 L2 20 L15.5 15.5 Z"
    style="fill: var(--shape-brand)"
  />
</svg>
