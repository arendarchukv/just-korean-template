---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<!-- Christmas: a pine sprig with red berries and a four-point star. -->
<svg viewBox="0 0 100 100" class:list={['shape', className]} aria-hidden="true" focusable="false">
  <path
    d="M10 92 L82 20"
    fill="none"
    style="stroke: var(--shape-indigo)"
    stroke-width="3"
    stroke-linecap="round"
  />
  <g fill="none" style="stroke: var(--shape-teal)" stroke-width="3.5" stroke-linecap="round">
    <path d="M22 80 L12 70 M22 80 L32 90 M32 70 L22 60 M32 70 L42 80 M42 60 L32 50 M42 60 L52 70 M52 50 L42 40 M52 50 L62 60 M62 40 L54 32 M62 40 L70 48 M72 30 L66 24 M72 30 L78 36" />
  </g>
  <circle cx="40" cy="70" r="4.5" style="fill: var(--shape-red)" />
  <circle cx="47" cy="74" r="4.5" style="fill: var(--shape-red)" />
  <circle cx="44" cy="80" r="4.5" style="fill: var(--shape-red)" />
  <path
    d="M82 52 L85 61 L94 64 L85 67 L82 76 L79 67 L70 64 L79 61 Z"
    style="fill: var(--shape-brand)"
  />
</svg>
