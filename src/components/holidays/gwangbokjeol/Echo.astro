---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<!-- 광복절 echo: the 태극 of the flag, with its official tilt and colours. -->
<svg viewBox="-25 -25 50 50" class:list={['shape', className]} aria-hidden="true" focusable="false">
  <g transform="rotate(33.69006752598)">
    <path style="fill: var(--shape-flag-red)" d="M12 0a18 18 0 11-36 0 24 24 0 1148 0" />
    <path
      style="fill: var(--shape-flag-blue)"
      d="M-24 0a24 24 0 1048 0A12 12 0 100 0a12 12 0 11-24 0"
    />
  </g>
</svg>
