---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<!--
  광복절: the 태극기, as a small paper flag set slightly askew. Geometry is the official flag's
  (3:2, taegeuk diameter half the height, tilted 33.69°, 건 top left, 곤 bottom right, 감 top right,
  리 bottom left), from the public-domain Wikimedia Flag_of_South_Korea.svg; only the tilt of
  the whole sheet is ours.
-->
<svg
  viewBox="-80 -58 160 116"
  class:list={['shape', className]}
  aria-hidden="true"
  focusable="false"
>
  <g transform="rotate(-5)">
    <rect
      x="-72"
      y="-48"
      width="144"
      height="96"
      rx="2"
      style="fill: var(--shape-flag-white); stroke: var(--shape-ink); stroke-opacity: 0.15"
    />
    <g style="stroke: var(--shape-flag-black)" stroke-width="4">
      <path
        transform="rotate(33.69006752598)"
        d="M-50-12v24m6 0v-24m6 0v24m76 0V1m0-2v-11m6 0v11m0 2v11m6 0V1m0-2v-11"
      />
      <path
        transform="rotate(-33.69006752598)"
        d="M-50-12v24m6 0V1m0-2v-11m6 0v24m76 0V1m0-2v-11m6 0v24m6 0V1m0-2v-11"
      />
    </g>
    <g transform="rotate(33.69006752598)">
      <path style="fill: var(--shape-flag-red)" d="M12 0a18 18 0 11-36 0 24 24 0 1148 0" />
      <path
        style="fill: var(--shape-flag-blue)"
        d="M-24 0a24 24 0 1048 0A12 12 0 100 0a12 12 0 11-24 0"
      />
    </g>
  </g>
</svg>
