---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<!-- 광복절 ("the return of light"): a 무궁화 rose of Sharon with rays of light. -->
<svg viewBox="0 0 100 100" class:list={['shape', className]} aria-hidden="true" focusable="false">
  <g fill="none" style="stroke: var(--shape-brand)" stroke-width="3" stroke-linecap="round">
    <path d="M50 6 V16 M50 84 V94 M6 50 H16 M84 50 H94 M19 19 L26 26 M74 74 L81 81 M81 19 L74 26 M19 81 L26 74" />
  </g>
  <g style="fill: var(--shape-paper); stroke: var(--shape-brand)" stroke-width="1.5">
    <ellipse cx="50" cy="31" rx="13" ry="17" />
    <ellipse cx="50" cy="31" rx="13" ry="17" transform="rotate(72 50 50)" />
    <ellipse cx="50" cy="31" rx="13" ry="17" transform="rotate(144 50 50)" />
    <ellipse cx="50" cy="31" rx="13" ry="17" transform="rotate(216 50 50)" />
    <ellipse cx="50" cy="31" rx="13" ry="17" transform="rotate(288 50 50)" />
  </g>
  <circle cx="50" cy="50" r="9" style="fill: var(--shape-red)" />
  <circle cx="50" cy="50" r="3" style="fill: var(--shape-paper)" />
</svg>
