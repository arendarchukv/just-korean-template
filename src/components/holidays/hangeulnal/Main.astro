---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<!-- 한글날: three 원고지 grid-paper tiles with the letters ㄱ ㅏ ㄴ. -->
<svg viewBox="0 0 100 100" class:list={['shape', className]} aria-hidden="true" focusable="false">
  <g style="fill: var(--shape-paper); stroke: var(--shape-brand)" stroke-width="1.5">
    <rect x="6" y="20" width="28" height="28" rx="2" transform="rotate(-6 20 34)" />
    <rect x="38" y="30" width="28" height="28" rx="2" transform="rotate(3 52 44)" />
    <rect x="66" y="44" width="28" height="28" rx="2" transform="rotate(-3 80 58)" />
  </g>
  <g
    fill="none"
    style="stroke: var(--shape-indigo)"
    stroke-width="4"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M12 28 H27 V42" transform="rotate(-6 20 34)" />
    <path d="M48 36 V52 M48 44 H57" transform="rotate(3 52 44)" />
    <path d="M73 50 V65 H88" transform="rotate(-3 80 58)" />
  </g>
</svg>
