---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<!-- Seollal echo: a small knot with its tassel. -->
<svg viewBox="0 0 40 40" class:list={['shape', className]} aria-hidden="true" focusable="false">
  <rect
    x="12"
    y="4"
    width="16"
    height="16"
    rx="3.5"
    transform="rotate(45 20 12)"
    style="fill: var(--shape-red)"
  />
  <path d="M16 24 H24 L26 38 H14 Z" style="fill: var(--shape-red)" />
</svg>
