---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<!-- Seollal: a 매듭 knot charm (norigae) on a cord, with its tassel. -->
<svg viewBox="0 0 100 100" class:list={['shape', className]} aria-hidden="true" focusable="false">
  <path d="M50 2 V22" style="stroke: var(--shape-indigo)" stroke-width="3" stroke-linecap="round" />
  <rect
    x="35"
    y="22"
    width="30"
    height="30"
    rx="6"
    transform="rotate(45 50 37)"
    style="fill: var(--shape-red)"
  />
  <rect
    x="43"
    y="30"
    width="14"
    height="14"
    rx="3"
    transform="rotate(45 50 37)"
    style="fill: var(--shape-paper)"
  />
  <circle cx="50" cy="62" r="4.5" style="fill: var(--shape-teal)" />
  <path d="M44 68 H56 L60 98 H40 Z" style="fill: var(--shape-red)" />
  <path
    d="M46 72 L45 96 M50 72 V96 M54 72 L55 96"
    fill="none"
    style="stroke: var(--shape-paper); stroke-opacity: 0.6"
    stroke-width="1.2"
  />
</svg>
