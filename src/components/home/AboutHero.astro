---
import { Image } from 'astro:assets';
import Collage from '@/components/shapes/Collage.astro';
import Icon, { type IconName } from '@/components/Icon.astro';
import { SITE_NAME_KO } from '@/lib/display-text';
import { getSite } from '@/content/queries';
import { TEACHER, TEACHER_PHOTO } from '@/data/teacher';
import { pick } from '@/i18n/localized';
import type { Lang } from '@/i18n/ui';
import { localizePath, useTranslations } from '@/i18n/utils';

/** Who she is and what she does: Korean serif title, two sentences, credentials, two actions. */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const home = pick(TEACHER, lang);
// Degree, certificate and channel, by their place in the credentials in teacher.ts; the line about
// the countries she taught in stays on About only.
const FACTS: [index: number, icon: IconName][] = [
  [0, 'cap'],
  [1, 'badge'],
  [3, 'play'],
];
const facts = FACTS.flatMap(([i, icon]) =>
  home.credentials[i] ? [{ text: home.credentials[i], icon }] : [],
);
// Booking opens TidyCal; until its link is set, the Classes page (never a dead button).
const tidycal = (await getSite()).tidycal;
const booking = tidycal || localizePath(lang, 'classes');
---

<section class="container-page about-hero" data-home-block="about" aria-labelledby="about-title">
  <div>
    <h1 id="about-title">
      <span lang="ko" class="font-display about-title-ko">
        {SITE_NAME_KO}
      </span>
      <span class="about-greeting">{home.greeting}</span>
    </h1>
    <p class="about-intro">{home.intro}</p>
    <div class="home-actions">
      <a
        class="btn btn-primary"
        data-book-class
        href={booking}
        target={tidycal ? '_blank' : undefined}
        rel={tidycal ? 'noopener noreferrer' : undefined}
      >
        {t('home.bookClass')}
      </a>
      <a class="btn btn-ghost" href={localizePath(lang, 'lessons')}>
        {t('home.watchLessons')}
      </a>
    </div>
    {facts.length > 0 && (
      <div class="hero-facts">
        <h2 class="sr-only">{t('home.credentials')}</h2>
        <ul>
          {facts.map((f) => (
            <li>
              <Icon name={f.icon} />
              <span>{f.text}</span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>

  <div class="about-side">
    {TEACHER_PHOTO ? (
      <Image
        src={TEACHER_PHOTO}
        alt={home.photoAlt ?? ''}
        width={560}
        height={640}
        class="about-photo"
        loading="eager"
      />
    ) : (
      <Collage variant="hero" />
    )}
  </div>
</section>
