---
import HeroPortrait from '@/components/home/HeroPortrait.astro';
import HeroStrings from '@/components/home/HeroStrings.astro';
import HolidayGreeting from '@/components/holidays/HolidayGreeting.astro';
import { holidayRender } from '@/lib/holiday-logic';
import Icon, { type IconName } from '@/components/Icon.astro';
import { SITE_NAME_KO } from '@/lib/display-text';
import { getSite } from '@/content/queries';
import { TEACHER, TEACHER_PHOTO } from '@/data/teacher';
import { pick } from '@/i18n/localized';
import type { Lang } from '@/i18n/ui';
import { localizePath, useTranslations } from '@/i18n/utils';

/** Who she is and what she does: Korean serif title, two sentences, credentials, two actions. */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const home = pick(TEACHER, lang);
// Degree, certificate, channel: in the order of the credentials in teacher.ts.
const FACT_ICONS: IconName[] = ['cap', 'badge', 'play'];
// Booking opens TidyCal; until its link is set, the Classes page (never a dead button).
const site = await getSite();
const tidycal = site.tidycal;
const holidays = holidayRender(site.holiday).pieces;
const booking = tidycal || localizePath(lang, 'classes');
---

<section class="container-page about-hero" data-home-block="about" aria-labelledby="about-title">
  <div>
    {holidays && <HolidayGreeting lang={lang} />}
    <h1 id="about-title">
      <span lang="ko" class="font-display about-title-ko">
        {SITE_NAME_KO}
      </span>
      <span class="about-greeting">{home.greeting}</span>
    </h1>
    <p class="about-intro">{home.intro}</p>
    <div class="home-actions">
      <a
        class="btn btn-primary"
        data-book-class
        href={booking}
        target={tidycal ? '_blank' : undefined}
        rel={tidycal ? 'noopener noreferrer' : undefined}
      >
        {t('home.bookClass')}
      </a>
      <a class="btn btn-ghost" href={localizePath(lang, 'lessons')}>
        {t('home.watchLessons')}
      </a>
    </div>
    {home.credentials.length > 0 && (
      <div class="hero-facts">
        <h2 class="sr-only">{t('home.credentials')}</h2>
        <HeroStrings />
        <ul>
          {home.credentials.map((c, i) => (
            <li>
              <Icon name={FACT_ICONS[i % FACT_ICONS.length]!} />
              <span>{c}</span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>

  <div class="about-side">
    <HeroPortrait photo={TEACHER_PHOTO || undefined} alt={home.photoAlt} holidays={holidays} />
  </div>
</section>
