---
import { getClasses, getSite } from '@/content/queries';
import type { Lang } from '@/i18n/ui';
import { localizePath, useTranslations } from '@/i18n/utils';

/** Class formats as a ruled timetable: one row per format, read from settings/classes.yml. */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { formats } = await getClasses();
const booking = (await getSite()).tidycal;
---

<section
  class="container-page home-section"
  data-home-block="classes"
  aria-labelledby="classes-title"
>
  <h2 id="classes-title" class="home-section-title">
    {t('home.classes.title')}
  </h2>
  <div class="table-scroll" tabindex="0" role="region" aria-labelledby="classes-title">
    <table class="timetable">
      <thead>
        <tr>
          <th scope="col">{t('home.classes.format')}</th>
          <th scope="col">{t('home.classes.forWhom')}</th>
          <th scope="col">{t('home.classes.how')}</th>
        </tr>
      </thead>
      <tbody>
        {formats.map((f) => (
          <tr>
            <th scope="row">{f.name}</th>
            <td data-label={t('home.classes.forWhom')}>{f.forWhom}</td>
            <td data-label={t('home.classes.how')}>{f.how}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <div class="home-actions">
    <a
      class="btn btn-primary"
      href={booking || '#'}
      aria-disabled={booking ? undefined : 'true'}
      target={booking ? '_blank' : undefined}
      rel={booking ? 'noopener noreferrer' : undefined}
    >
      {t('home.bookClass')}
    </a>
    <a class="btn btn-link" href={localizePath(lang, 'classes')}>
      {t('home.classes.more')}
    </a>
  </div>
</section>
