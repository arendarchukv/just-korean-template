---
import FormatCard from '@/components/FormatCard.astro';
import SectionHead from '@/components/SectionHead.astro';
import { CLASSES } from '@/data/classes';
import { getSite } from '@/content/queries';
import { pick } from '@/i18n/localized';
import type { Lang } from '@/i18n/ui';
import { localizePath, useTranslations } from '@/i18n/utils';

/** Home block: the three class formats as cards (the same as on Classes), then a bar to the page. */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const site = await getSite();
// Booking opens TidyCal; until its link is set, the Classes page (never a dead button).
const contact = site.contactForm || localizePath(lang, 'contact');
const classesPage = localizePath(lang, 'classes');
---

<section
  class="container-page home-section"
  data-home-block="classes"
  aria-labelledby="classes-title"
>
  <SectionHead
    id="classes-title"
    eyebrow={t('home.classes.eyebrow')}
    title={t('home.classes.title')}
    lead={t('home.classes.lead')}
  />
  <div class="formats">
    {pick(CLASSES, lang).formats.map((format, i) => {
      const book = format.action === 'book';
      return (
        <FormatCard
          format={format}
          index={i + 1}
          href={book ? site.tidycal || classesPage : contact}
          label={book ? t('home.bookClass') : t('classes.ask')}
          book={book}
        />
      );
    })}
  </div>
  <div class="classes-bar">
    <p>{t('home.classes.ctaText')}</p>
    <a class="btn btn-ghost" href={classesPage}>
      {t('home.classes.more')} →
    </a>
  </div>
</section>
