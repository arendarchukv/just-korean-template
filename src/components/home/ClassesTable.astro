---
import { CLASSES } from '@/data/classes';
import { pick } from '@/i18n/localized';
import { getSite } from '@/content/queries';
import type { Lang } from '@/i18n/ui';
import { localizePath, useTranslations } from '@/i18n/utils';

/** Home block: the class formats in one line each, and booking (TidyCal). */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
// Booking opens TidyCal; until its link is set, the Classes page (never a dead button).
const tidycal = (await getSite()).tidycal;
const booking = tidycal || localizePath(lang, 'classes');
---

<section
  class="container-page home-section"
  data-home-block="classes"
  aria-labelledby="classes-title"
>
  <h2 id="classes-title" class="home-section-title">
    {t('home.classes.title')}
  </h2>
  <ul class="class-lines">
    {pick(CLASSES, lang).formats.map((f) => (
      <li>
        <span class="class-line-name">{f.name}</span>
        <span class="class-line-text">{f.forWhom}</span>
      </li>
    ))}
  </ul>
  <div class="home-actions">
    <a
      class="btn btn-primary"
      data-book-class
      href={booking}
      target={tidycal ? '_blank' : undefined}
      rel={tidycal ? 'noopener noreferrer' : undefined}
    >
      {t('home.bookClass')}
    </a>
    <a class="btn btn-link" href={localizePath(lang, 'classes')}>
      {t('home.classes.more')}
    </a>
  </div>
</section>
