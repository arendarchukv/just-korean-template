---
/**
 * Home hero picture: her photo, cut out, standing in a soft disc that clips it at the bottom, with
 * grid paper and a cut-paper landscape on the right: mountain ranges with a snow-capped peak and a
 * strip of mist, in front of the disc and behind the photo; the sun and a cloud by day or the moon
 * and stars by night (the theme decides, so the ink of the theme switch pours the night over the
 * hills). No handwritten notes, so it stays calm. The landscape is decorative; the photo has its
 * alt text. Hidden in print (`collage`), where the text takes the full width.
 */
import { Image } from 'astro:assets';
import Shape from '@/components/shapes/Shape.astro';
import teacherPhoto from '@/assets/teacher-photo.png';
import HolidayMotifs from '@/components/holidays/HolidayMotifs.astro';

interface Props {
  /** A replacement photo as an https:// link (cut out); by default her profile photo in assets. */
  photo?: string;
  alt: string;
  /** Holiday motifs join the collage (Site settings allow holidays); one shows at a time. */
  holidays?: boolean;
}
const { photo, alt, holidays = false } = Astro.props;
// The picture is at most 30rem wide (.hero-portrait) and the photo a little wider than it.
const SIZES = '(min-width: 32rem) 32rem, 100vw';
// Mountain ranges, far to near, cut from paper: each a silhouette with a ridge of shoulders and
// saddles (`lit`), the shaded faces on the right of its peaks (`shade`), and on the high peak
// snow on both faces. Broad, never thin spikes; the bases go under a strip of mist.
const RANGES = [
  {
    tone: 'far',
    lit: 'M50 100L58 90L62 88L68 79L72 82L77 74L82 80L86 78L90 84V100Z',
    shade: 'M68 79L72 82L70 90L66 100H63ZM77 74L82 80L86 78L90 84V100H78L80 88Z',
  },
  {
    tone: 'mountain',
    lit: 'M62 100L70 90L75 86L80 78L84 80L89 66L92 61L96 40L100.5 47L103 49.5L110 58L116 70L120 80L124 100Z',
    shade:
      'M96 40L100.5 47L103 49.5L110 58L116 70L120 80L124 100H95L97 88L94 74L97.5 58ZM80 78L84 80L82 90L80 100H76L79 88Z',
    // Snow over the whole summit, on both faces, its lower edge cut in a zigzag.
    snow: {
      lit: 'M96 40L93.71 52L94.7 50.8L95.6 53L96.4 51.4L97 52Z',
      shade: 'M96 40L97 52L98.6 50.6L100.2 52.8L102 50.8L103.6 52.6L105.06 52L103 49.5L100.5 47Z',
    },
  },
  {
    tone: 'hill',
    lit: 'M66 100L74 93L78 91L83 92L88 86L92 88L97 85L104 89L112 87L122 93L126 100Z',
    shade: 'M88 86L92 88L91 94L89 100H85L87 93ZM97 85L104 89L112 87L122 93L126 100H98L99 92Z',
  },
];
---

<div class="collage hero-portrait">
  <Shape name="grid" tone="paper" texture="grid" class="hero-portrait-grid" />
  <svg class="hero-scene hero-scene-sky" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
    <g class="scene-day">
      <circle class="scene-sun" cx="84" cy="27" r="6.5" />
      <path
        class="scene-cloud"
        d="M75 32.5C75 30 77.5 29 79.5 30C80 27 84.5 26 86.5 28.5C88 27 91 27.5 91 30.5C93 30.5 94 32.5 92.5 33.8H76.5C75.5 33.8 75 33.3 75 32.5Z"
      />
    </g>
    <g class="scene-night">
      <path class="scene-moon" d="M86 20A8 8 0 1 0 86 36A10 10 0 0 1 86 20Z" />
      <circle cx="66" cy="14" r="0.55" />
      <circle cx="80" cy="12" r="0.45" />
      <circle cx="97" cy="44" r="0.45" />
      <circle cx="62" cy="26" r="0.4" />
      <circle cx="74" cy="4" r="0.4" />
    </g>
  </svg>
  {holidays && <HolidayMotifs kind="main" class="hero-portrait-holiday" />}
  <div class="hero-portrait-disc" aria-hidden="true"></div>
  <!-- Three ranges on the right, the snow-capped peak to the right, and a strip of mist; in front of
       the disc, behind the photo. Each range lies on its own paper shadow. -->
  <svg class="hero-scene" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
    {RANGES.map(({ tone, lit, shade, snow }) => (
      <>
        <path class="scene-shadow" d={lit} transform="translate(1.1 0.8)" />
        <path class={`scene-${tone}`} d={lit} />
        <path class={`scene-${tone}-shade`} d={shade} />
        {snow && <path class="scene-snow" d={snow.lit} />}
        {snow && <path class="scene-snow-shade" d={snow.shade} />}
      </>
    ))}
    <path
      class="scene-mist"
      d="M48 100C54 97 60 96.5 66 97.5C72 98.7 78 96 84 96.4C92 96.8 98 98.6 104 97.2C110 96 116 96.6 128 97V100Z"
    />
  </svg>
  {photo ? (
    <Image
      src={photo}
      alt={alt}
      width={560}
      height={560}
      widths={[480, 640, 960]}
      sizes={SIZES}
      class="hero-portrait-photo"
      loading="eager"
      fetchpriority="high"
    />
  ) : (
    <Image
      src={teacherPhoto}
      alt={alt}
      width={560}
      sizes={SIZES}
      class="hero-portrait-photo"
      loading="eager"
      fetchpriority="high"
    />
  )}
</div>
