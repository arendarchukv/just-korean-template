---
/**
 * Home hero picture: her photo, cut out, standing in a soft disc that clips it at the bottom, with
 * grid paper and a cut-paper landscape on the right: mountain ranges with a snow-capped peak and a
 * strip of mist, in front of the disc and behind the photo; the sun and a cloud by day or the moon
 * and stars by night (the theme decides, so the ink of the theme switch pours the night over the
 * hills). No handwritten notes, so it stays calm. The landscape is decorative; the photo has its
 * alt text. Hidden in print (`collage`), where the text takes the full width.
 */
import { Image } from 'astro:assets';
import Shape from '@/components/shapes/Shape.astro';
import teacherPhoto from '@/assets/teacher-photo.png';
import HolidayMotifs from '@/components/holidays/HolidayMotifs.astro';

interface Props {
  /** A replacement photo as an https:// link (cut out); by default her profile photo in assets. */
  photo?: string;
  alt: string;
  /** Holiday motifs join the collage (Site settings allow holidays); one shows at a time. */
  holidays?: boolean;
}
const { photo, alt, holidays = false } = Astro.props;
// The picture is at most 30rem wide (.hero-portrait) and the photo a little wider than it.
const SIZES = '(min-width: 32rem) 32rem, 100vw';
// Mountain ranges, far to near, cut from paper: each a silhouette with a ridge of shoulders and
// saddles (`lit`), the shaded faces on the right of its peaks (`shade`), and on the high peak
// snow on both faces. Broad, never thin spikes; the bases go under a strip of mist.
// The grid paper's squares (9 units, from 9 to 90 each way) with 가나다 … 하 in reading order, round
// and round.
const GANADA = '가나다라마바사아자차카타파하';
const GRID_CELLS = Array.from({ length: 81 }, (_, i) => ({
  x: 9 + (i % 9) * 9,
  y: 9 + Math.floor(i / 9) * 9,
  letter: GANADA[i % GANADA.length],
}));

// Christmas snow: [x, radius, seconds to fall, how far into the fall it starts].
const SNOW = [
  [4, 0.7, 13, 2],
  [12, 0.5, 11, 7],
  [20, 0.9, 15, 11],
  [27, 0.6, 12, 4],
  [35, 0.8, 14, 9],
  [43, 0.5, 10, 1],
  [51, 0.7, 13, 6],
  [58, 0.9, 16, 12],
  [66, 0.6, 11, 3],
  [73, 0.8, 14, 8],
  [80, 0.5, 12, 10],
  [87, 0.9, 15, 5],
  [94, 0.6, 13, 0],
  [101, 0.8, 11, 6],
  [108, 0.5, 14, 9],
] as const;

// 한글날: 한 글 날 on paper tiles in three squares of the second row, clear of the photo.
const HANGEUL_DAY = [...'한글날'].map((letter, i) => ({ x: 9 + i * 9, y: 18, letter }));

const RANGES = [
  {
    tone: 'far',
    lit: 'M50 100L58 90L62 88L68 79L72 82L77 74L82 80L86 78L90 84V100Z',
    shade: 'M68 79L72 82L70 90L66 100H63ZM77 74L82 80L86 78L90 84V100H78L80 88Z',
  },
  {
    tone: 'mountain',
    lit: 'M62 100L70 90L75 86L80 78L84 80L89 66L92 61L96 40L100.5 47L103 49.5L110 58L116 70L120 80L124 100Z',
    shade:
      'M96 40L100.5 47L103 49.5L110 58L116 70L120 80L124 100H95L97 88L94 74L97.5 58ZM80 78L84 80L82 90L80 100H76L79 88Z',
    // Snow over the whole summit, on both faces, its lower edge cut in a zigzag.
    snow: {
      lit: 'M96 40L93.71 52L94.7 50.8L95.6 53L96.4 51.4L97 52Z',
      shade: 'M96 40L97 52L98.6 50.6L100.2 52.8L102 50.8L103.6 52.6L105.06 52L103 49.5L100.5 47Z',
    },
  },
  {
    tone: 'hill',
    lit: 'M66 100L74 93L78 91L83 92L88 86L92 88L97 85L104 89L112 87L122 93L126 100Z',
    shade: 'M88 86L92 88L91 94L89 100H85L87 93ZM97 85L104 89L112 87L122 93L126 100H98L99 92Z',
  },
];
---

<div class="collage hero-portrait">
  <Shape name="grid" tone="paper" texture="grid" class="hero-portrait-grid" />
  <!-- Over the grid paper, cell for cell (its 9-unit squares): a 가나다 letter in each, shown faintly
       under the pointer and fading slowly after it, like a light passing over the sheet. -->
  <svg class="hero-portrait-grid hero-grid-letters" viewBox="0 0 100 100" aria-hidden="true">
    {GRID_CELLS.map(({ x, y, letter }) => (
      <g class="grid-cell">
        <rect x={x} y={y} width="9" height="9" />
        <text x={x + 4.5} y={y + 6.6} lang="ko">
          {letter}
        </text>
      </g>
    ))}
    {holidays && (
      <g data-holiday-piece="hangeulnal" class="grid-hangeul">
        {HANGEUL_DAY.map(({ x, y, letter }) => (
          <>
            <rect x={x} y={y} width="9" height="9" rx="0.6" />
            <text x={x + 4.5} y={y + 6.6} lang="ko">
              {letter}
            </text>
          </>
        ))}
      </g>
    )}
  </svg>
  <svg class="hero-scene hero-scene-sky" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
    <g class="scene-day">
      <g class="scene-glow">
        <circle class="scene-halo" cx="84" cy="27" r="11" />
        <circle class="scene-halo" cx="84" cy="27" r="8.6" />
        <circle class="scene-sun" cx="84" cy="27" r="6.5" />
      </g>
      <path
        class="scene-cloud"
        d="M75 32.5C75 30 77.5 29 79.5 30C80 27 84.5 26 86.5 28.5C88 27 91 27.5 91 30.5C93 30.5 94 32.5 92.5 33.8H76.5C75.5 33.8 75 33.3 75 32.5Z"
      />
    </g>
    <g class="scene-night">
      <g class="scene-glow">
        <circle class="scene-halo" cx="84" cy="28" r="12" />
        <circle class="scene-halo" cx="84" cy="28" r="9.6" />
        <path class="scene-moon" d="M86 20A8 8 0 1 0 86 36A10 10 0 0 1 86 20Z" />
      </g>
      <circle cx="66" cy="14" r="0.55" />
      <circle cx="80" cy="12" r="0.45" />
      <circle cx="97" cy="44" r="0.45" />
      <circle cx="62" cy="26" r="0.4" />
      <circle cx="74" cy="4" r="0.4" />
    </g>
  </svg>
  {holidays && <HolidayMotifs kind="main" class="hero-portrait-holiday" />}
  {holidays && (
    <svg
      class="hero-scene"
      data-holiday-piece="chuseok"
      viewBox="0 0 100 100"
      aria-hidden="true"
      focusable="false"
    >
      <g class="scene-glow">
        <circle class="scene-halo" cx="84" cy="24" r="16" />
        <circle class="scene-halo" cx="84" cy="24" r="13.4" />
        <circle class="scene-full-moon" cx="84" cy="24" r="11" />
      </g>
      <path class="scene-branch" d="M66 4C74 6 82 9 90 8C95 7.5 99 6 103 4" />
      <path class="scene-leaf" d="M74 6.8C73 3 75.5 0.5 79 0.6C79 3.8 77 6.2 74 6.8Z" />
      <path class="scene-leaf" d="M92 7.8C94 4.6 97.5 3.8 100 5C98.4 7.8 95.4 8.8 92 7.8Z" />
      <circle class="scene-persimmon" cx="78" cy="10.2" r="2.6" />
      <circle class="scene-persimmon" cx="89" cy="11.4" r="2.9" />
      <circle class="scene-persimmon" cx="98" cy="9" r="2.3" />
    </svg>
  )}
  <div class="hero-portrait-disc" aria-hidden="true"></div>
  <!-- Three ranges on the right, the snow-capped peak to the right, and a strip of mist; in front of
       the disc, behind the photo. Each range lies on its own paper shadow. -->
  <svg class="hero-scene" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
    {RANGES.map(({ tone, lit, shade, snow }) => (
      <>
        <path class="scene-shadow" d={lit} transform="translate(1.1 0.8)" />
        <path class={`scene-${tone}`} d={lit} />
        <path class={`scene-${tone}-shade`} d={shade} />
        {snow && <path class="scene-snow" d={snow.lit} />}
        {snow && <path class="scene-snow-shade" d={snow.shade} />}
      </>
    ))}
    <path
      class="scene-mist"
      d="M48 100C54 97 60 96.5 66 97.5C72 98.7 78 96 84 96.4C92 96.8 98 98.6 104 97.2C110 96 116 96.6 128 97V100Z"
    />
  </svg>
  {holidays && (
    <svg
      class="hero-scene scene-snowfall"
      data-holiday-piece="christmas"
      viewBox="0 0 100 100"
      aria-hidden="true"
      focusable="false"
    >
      {SNOW.map(([x, r, d, delay]) => (
        <circle
          class="scene-flake"
          cx={x}
          cy="-6"
          r={r}
          style={`--fall: ${d}s; --delay: -${delay}s; --rest: ${Math.round((delay / d) * 112)}px`}
        />
      ))}
    </svg>
  )}
  {photo ? (
    <Image
      src={photo}
      alt={alt}
      width={560}
      height={560}
      widths={[480, 640, 960]}
      sizes={SIZES}
      class="hero-portrait-photo"
      loading="eager"
      fetchpriority="high"
    />
  ) : (
    <Image
      src={teacherPhoto}
      alt={alt}
      width={560}
      sizes={SIZES}
      class="hero-portrait-photo"
      loading="eager"
      fetchpriority="high"
    />
  )}
</div>

<!-- Global (the theme is on <html>), but loaded with this component, so only on the home page and
     not in the shared stylesheet. -->
<style is:global>
  @layer components {
    /* Holidays that live in the landscape instead of a motif in the corner: on 추석 the full moon
       rises behind the mountains; on 한글날 한 글 날 lie on tiles in the grid paper; at Christmas
       snow falls behind her; on both the sky is back. */
    :root[data-holiday='chuseok'] .hero-portrait-holiday,
    :root[data-holiday='hangeulnal'] .hero-portrait-holiday,
    :root[data-holiday='christmas'] .hero-portrait-holiday {
      display: none;
    }
    :root[data-holiday='hangeulnal'] .hero-scene-sky,
    :root[data-holiday='christmas'] .hero-scene-sky {
      display: block;
    }
    /* Christmas: snow falling behind her. */
    .scene-flake {
      fill: var(--scene-flake);
      animation: snow-fall var(--fall) linear var(--delay) infinite;
    }
    @keyframes snow-fall {
      0% {
        translate: 0 0;
      }
      50% {
        translate: 2px 56px;
      }
      100% {
        translate: -1px 112px;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .scene-flake {
        animation: none;
        /* Still, each flake where it would be in its fall. */
        translate: 0 var(--rest);
      }
    }
    .scene-full-moon {
      fill: var(--scene-moon-full);
      stroke: var(--scene-line);
      stroke-width: 0.7;
    }
    .scene-branch {
      fill: none;
      stroke: var(--shape-indigo);
      stroke-width: 1.1;
      stroke-linecap: round;
    }
    .scene-leaf {
      fill: var(--shape-teal);
    }
    .scene-persimmon {
      fill: var(--shape-red);
    }
    .grid-hangeul rect {
      fill: var(--scene-cloud);
      stroke: var(--shape-brand);
      stroke-width: 0.5;
    }
    .hero-grid-letters .grid-hangeul text {
      fill: var(--scene-letter);
      font-size: 5.6px;
      font-weight: 700;
      text-anchor: middle;
      opacity: 1;
    }
    .hero-scene {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      overflow: visible;
      /* The collage takes no pointer; only the grid letters and the sun or moon answer it, through
       the scene and the photo. */
      pointer-events: none;
    }
    /* Grid paper letters: faint under the pointer, fading slowly after it. */
    .hero-grid-letters {
      pointer-events: auto;
    }
    .hero-grid-letters rect {
      fill: transparent;
    }
    .hero-grid-letters text {
      fill: var(--scene-letter);
      font-size: 5.4px;
      font-weight: 600;
      text-anchor: middle;
      opacity: 0;
      transition: opacity 1.5s ease-out;
    }
    .grid-cell:hover text {
      opacity: 0.45;
      transition-duration: 0.15s;
    }
    :root[data-theme='dark'] .grid-cell:hover text {
      opacity: 0.65;
    }
    /* Sun and moon: a soft ring of light grows under the pointer. */
    .scene-glow {
      pointer-events: auto;
    }
    .scene-halo {
      fill: var(--scene-glow);
      opacity: 0;
      transform-box: fill-box;
      transform-origin: center;
      scale: 0.8;
      transition:
        opacity 0.4s ease-out,
        scale 0.4s ease-out;
    }
    .scene-glow:hover .scene-halo {
      opacity: 0.5;
      scale: 1;
    }
    .scene-glow:hover .scene-halo + .scene-halo {
      opacity: 0.8;
    }
    @media (prefers-reduced-motion: reduce) {
      .hero-grid-letters text,
      .scene-halo {
        transition: none;
      }
    }
    .scene-far {
      fill: var(--scene-far);
    }
    .scene-mountain {
      fill: var(--scene-mountain);
    }
    .scene-hill {
      fill: var(--scene-hill);
    }
    .scene-far-shade {
      fill: var(--scene-far-shade);
    }
    .scene-mountain-shade {
      fill: var(--scene-mountain-shade);
    }
    .scene-hill-shade {
      fill: var(--scene-hill-shade);
    }
    .scene-snow {
      fill: var(--scene-snow);
    }
    .scene-snow-shade {
      fill: var(--scene-snow-shade);
    }
    .scene-mist {
      fill: var(--scene-cloud);
    }
    .scene-shadow {
      fill: var(--scene-shadow);
    }
    .scene-cloud {
      fill: var(--scene-cloud);
      stroke: var(--scene-line);
      stroke-width: 0.5;
    }
    .scene-sun {
      fill: var(--scene-sun);
      stroke: var(--scene-line);
      stroke-width: 0.7;
    }
    .scene-night {
      display: none;
      fill: var(--scene-sun);
    }
    :root[data-theme='dark'] .scene-day {
      display: none;
    }
    :root[data-theme='dark'] .scene-night {
      display: inline;
    }
  }
</style>
