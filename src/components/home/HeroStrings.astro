---
/**
 * The hero rule as three 가야금 strings, each on its 안족 (bridge), the bridges set aslant as on
 * the instrument. At rest a quiet triple line; a pointer crossing a string plucks it there: it
 * rings with a few decaying harmonics and, once the visitor has tapped the strings, sounds a note
 * of the 평조 pentatonic (synthesised, no files) with a light 농현 vibrato. Decorative only.
 */

// y of each string (px from the top of the 26px strip), its bridge (% of the width), its note (Hz).
const STRINGS = [
  { y: 5, bridge: 8, note: 311.13 }, // 황 (E♭4)
  { y: 12, bridge: 14, note: 349.23 }, // 태 (F4)
  { y: 19, bridge: 20, note: 415.3 }, // 중 (A♭4)
];
---

<svg class="hero-strings" data-hero-strings aria-hidden="true" focusable="false" data-print="hide">
  {STRINGS.map((s) => (
    <g data-string data-note={s.note} data-y={s.y}>
      <line class="hero-string" x1="0" x2="100%" y1={s.y} y2={s.y} />
      <path class="hero-string-wave" />
      <svg x={`${s.bridge}%`} y={s.y} overflow="visible">
        <path class="hero-bridge" d="M-5 6L0 0L5 6" />
      </svg>
    </g>
  ))}
</svg>

<style>
  .hero-strings {
    display: block;
    width: 100%;
    height: 26px;
    margin-top: 1.5rem;
    overflow: visible;
    touch-action: pan-y;
  }
  .hero-string,
  .hero-string-wave {
    fill: none;
    stroke: var(--color-border);
    stroke-width: 1;
  }
  .hero-string-wave {
    display: none;
  }
  [data-ringing] .hero-string {
    display: none;
  }
  [data-ringing] .hero-string-wave {
    display: inline;
    animation: string-fade 2.4s ease-out forwards;
  }
  .hero-bridge {
    fill: none;
    stroke: var(--color-muted);
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.55;
  }
  @keyframes string-fade {
    from {
      stroke: var(--color-teal);
    }
    to {
      stroke: var(--color-border);
    }
  }
</style>

<script>
  const strip = document.querySelector<SVGSVGElement>('[data-hero-strings]');
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  const RING = 2.4; // seconds a pluck rings

  type Str = {
    g: SVGGElement;
    wave: SVGPathElement;
    y: number;
    note: number;
    at: number;
    pos: number;
    amp: number;
  };
  const strings: Str[] = [...(strip?.querySelectorAll<SVGGElement>('[data-string]') ?? [])].map(
    (g) => ({
      g,
      wave: g.querySelector('path.hero-string-wave')!,
      y: Number(g.dataset.y),
      note: Number(g.dataset.note),
      at: 0,
      pos: 0.5,
      amp: 0,
    }),
  );

  // Sound: a Karplus-Strong pluck rendered once per note. Browsers allow audio only after the
  // visitor taps, so the strings stay silent until a tap on them.
  let audio: AudioContext | undefined;
  const buffers = new Map<number, AudioBuffer>();
  function wake() {
    audio ??= new AudioContext();
    if (audio.state === 'suspended') void audio.resume();
  }
  function pluckBuffer(ctx: AudioContext, freq: number) {
    let buffer = buffers.get(freq);
    if (buffer) return buffer;
    const length = Math.floor(ctx.sampleRate * RING);
    buffer = ctx.createBuffer(1, length, ctx.sampleRate);
    const data = buffer.getChannelData(0);
    const ring = new Float32Array(Math.round(ctx.sampleRate / freq)).map(
      () => Math.random() * 2 - 1,
    );
    for (let i = 0, p = 0; i < length; i++, p = (p + 1) % ring.length) {
      data[i] = ring[p]!;
      ring[p] = 0.498 * (ring[p]! + ring[(p + 1) % ring.length]!);
    }
    buffers.set(freq, buffer);
    return buffer;
  }
  function sound(freq: number, strength: number) {
    if (audio?.state !== 'running') return;
    const t = audio.currentTime;
    const source = new AudioBufferSourceNode(audio, { buffer: pluckBuffer(audio, freq) });
    const gain = new GainNode(audio, { gain: 0.06 + 0.14 * strength });
    // 농현: a gentle vibrato that sets in after the attack.
    const vibrato = new OscillatorNode(audio, { frequency: 5.2 });
    const depth = new GainNode(audio, { gain: 0 });
    depth.gain.linearRampToValueAtTime(0.006, t + 0.45);
    vibrato.connect(depth).connect(source.playbackRate);
    source
      .connect(gain)
      .connect(new BiquadFilterNode(audio, { frequency: 3200 }))
      .connect(audio.destination);
    source.start(t);
    vibrato.start(t);
    source.stop(t + RING);
    vibrato.stop(t + RING);
  }

  // Shape of a plucked string: harmonics sin(nπp)/n², the higher ones dying faster.
  function draw(s: Str, width: number, t: number) {
    const steps = Math.max(24, Math.round(width / 10));
    let d = `M0 ${s.y}`;
    for (let i = 1; i <= steps; i++) {
      const u = i / steps;
      let y = 0;
      for (let n = 1; n <= 6; n++) {
        const a = Math.sin(n * Math.PI * s.pos) / (n * n);
        y +=
          a *
          Math.sin(n * Math.PI * u) *
          Math.cos(n * 14 * Math.PI * t) *
          Math.exp(-t * (1.6 + n * 0.9));
      }
      d += `L${(u * width).toFixed(1)} ${(s.y + y * s.amp * 7).toFixed(2)}`;
    }
    s.wave.setAttribute('d', d);
  }

  let frame = 0;
  function tick(now: number) {
    const width = strip!.getBoundingClientRect().width;
    let ringing = false;
    for (const s of strings) {
      if (!s.at) continue;
      const t = (now - s.at) / 1000;
      if (t > RING) {
        s.at = 0;
        s.g.removeAttribute('data-ringing');
      } else {
        draw(s, width, t);
        ringing = true;
      }
    }
    frame = ringing ? requestAnimationFrame(tick) : 0;
  }

  function pluck(s: Str, x: number, strength: number) {
    const now = performance.now();
    if (s.at && now - s.at < 140) return; // one pluck per touch, not one per pointer event
    sound(s.note, strength);
    if (still.matches) return;
    const width = strip!.getBoundingClientRect().width;
    s.at = now;
    s.pos = Math.min(0.92, Math.max(0.08, x / width));
    s.amp = 0.5 + 0.8 * strength;
    // Restart the colour fade.
    s.g.removeAttribute('data-ringing');
    void s.g.getBoundingClientRect();
    s.g.setAttribute('data-ringing', '');
    frame ||= requestAnimationFrame(tick);
  }

  if (strip) {
    // A pointer crossing a string between two moves plucks it where it crossed.
    let last: { x: number; y: number; t: number } | undefined;
    // The whole hero listens, so a pointer coming from above is seen before the top string.
    const area = strip.closest('section') ?? strip.parentElement!;
    const at = (e: PointerEvent) => {
      const box = strip.getBoundingClientRect();
      return { x: e.clientX - box.left, y: e.clientY - box.top, t: e.timeStamp };
    };
    area.addEventListener('pointermove', (e) => {
      const p = at(e);
      if (last && last.y !== p.y) {
        for (const s of strings) {
          if ((last.y - s.y) * (p.y - s.y) > 0) continue;
          const x = last.x + ((s.y - last.y) / (p.y - last.y)) * (p.x - last.x);
          if (x < 0 || x > strip.clientWidth) continue;
          const speed = Math.hypot(p.x - last.x, p.y - last.y) / Math.max(8, p.t - last.t);
          pluck(s, x, Math.min(1, speed / 1.2));
        }
      }
      last = p;
    });
    area.addEventListener('pointerleave', () => (last = undefined));
    // A tap plucks the nearest string and lets the strings sound from then on.
    strip.addEventListener('pointerdown', (e) => {
      wake();
      const p = at(e);
      const nearest = strings.reduce((a, b) => (Math.abs(b.y - p.y) < Math.abs(a.y - p.y) ? b : a));
      pluck(nearest, p.x, 0.7);
    });
    strip.addEventListener('pointerup', wake);
  }
</script>
