---
import { Image } from 'astro:assets';
import { getLessons } from '@/content/queries';
import { NEW_LESSONS_COUNT } from '@/data/teacher';
import { selectNewLessons } from '@/lib/content-logic';
import { youtubeThumbnail } from '@/lib/youtube';
import { playlistText } from '@/data/playlists';
import type { Lang, UIKey } from '@/i18n/ui';
import { localizePath, useTranslations } from '@/i18n/utils';
import SectionHead from '@/components/SectionHead.astro';

/** Latest lessons with a video: thumbnails fetched and optimised at build (no requests to Google). */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const lessons = selectNewLessons(await getLessons(), NEW_LESSONS_COUNT);
const dateFormat = new Intl.DateTimeFormat(lang === 'ko' ? 'ko-KR' : 'en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});
---

{lessons.length > 0 && (
  <section
    class="container-page home-section"
    data-home-block="new-lessons"
    aria-labelledby="new-lessons-title"
  >
    <SectionHead
      id="new-lessons-title"
      eyebrow={t('home.newLessons.eyebrow')}
      title={t('home.newLessons.title')}
      lead={t('home.newLessons.lead')}
      link={{ href: localizePath(lang, 'lessons'), label: t('home.newLessons.all') }}
    />
    <ul class="lesson-row">
      {lessons.map((l) => (
        <li>
          <a class="lesson-card" href={localizePath(lang, `lessons/${l.id}`)}>
            <Image
              src={youtubeThumbnail(l.youtube!)}
              alt=""
              width={480}
              height={270}
              fit="cover"
              class="lesson-thumb"
            />
            <span class="lesson-card-body">
              <span class="lesson-meta">
                {l.playlistEntry && `${playlistText(l.playlistEntry, lang).title} · `}
                <time datetime={l.date.toISOString().slice(0, 10)}>
                  {dateFormat.format(l.date)}
                </time>
              </span>
              <span class="lesson-title">{l.title}</span>
              <span class="lesson-foot">
                <span>{t(`grammar.level.${l.level}` as UIKey)}</span>
                <span class="lesson-watch" aria-hidden="true">
                  {t('home.newLessons.watch')} →
                </span>
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}
