---
import { getLessons } from '@/content/queries';
import { NEW_LESSONS_COUNT } from '@/data/teacher';
import { selectNewLessons } from '@/lib/content-logic';
import type { Lang } from '@/i18n/ui';
import { localizePath, useTranslations } from '@/i18n/utils';
import SectionHead from '@/components/SectionHead.astro';
import LessonCard from '@/components/LessonCard.astro';

/** Latest lessons with a video: thumbnails fetched and optimised at build (no requests to Google). */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const lessons = selectNewLessons(await getLessons(), NEW_LESSONS_COUNT);
---

{lessons.length > 0 && (
  <section
    class="container-page home-section"
    data-home-block="new-lessons"
    aria-labelledby="new-lessons-title"
  >
    <SectionHead
      id="new-lessons-title"
      eyebrow={t('home.newLessons.eyebrow')}
      title={t('home.newLessons.title')}
      lead={t('home.newLessons.lead')}
      link={{ href: localizePath(lang, 'lessons'), label: t('home.newLessons.all') }}
    />
    <ul class="lesson-row">
      {lessons.map((l) => (
        <li>
          <LessonCard lesson={l} lang={lang} />
        </li>
      ))}
    </ul>
  </section>
)}
