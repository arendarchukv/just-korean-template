---
import type { Lang, UIKey } from '@/i18n/ui';
import { localizePath, useTranslations } from '@/i18n/utils';
import { CONTENTS_TERMS } from '@/lib/display-text';

/**
 * 목차: the site's sections as a textbook table of contents. Sections that are not built yet
 * point at their placeholder pages; update `path` when a section lands.
 */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Korean terms are set in the serif display font: they live in display-text.ts with the font list.
const PATHS: Record<keyof typeof CONTENTS_TERMS, string> = {
  lessons: 'learn',
  materials: 'materials',
  practice: 'learn',
  speaking: 'learn',
  news: 'news',
};
const ITEMS = (Object.keys(PATHS) as (keyof typeof CONTENTS_TERMS)[]).map((k) => ({
  key: k,
  term: CONTENTS_TERMS[k],
  path: PATHS[k],
}));
const key = (item: string, part: 'title' | 'body') => `home.contents.${item}.${part}` as UIKey;
---

<section
  class="container-page home-section"
  data-home-block="contents"
  aria-labelledby="contents-title"
>
  <h2 id="contents-title" class="home-section-title">
    {t('home.contents.title')}
  </h2>
  <ol class="toc">
    {ITEMS.map((item, i) => (
      <li>
        <a href={localizePath(lang, item.path)} class="toc-link">
          <span class="toc-number" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <span class="toc-body">
            <span class="toc-title">
              {lang !== 'ko' && (
                <span lang="ko" class="toc-term font-display">
                  {item.term}
                </span>
              )}
              {t(key(item.key, 'title'))}
            </span>
            <span class="toc-text">{t(key(item.key, 'body'))}</span>
          </span>
          <span class="toc-arrow" aria-hidden="true">
            →
          </span>
        </a>
      </li>
    ))}
  </ol>
</section>
