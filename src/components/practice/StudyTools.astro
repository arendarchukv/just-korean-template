---
import Icon from '@/components/Icon.astro';
import Shape from '@/components/shapes/Shape.astro';
import { QUICK_LINKS } from '@/data/links';
import { KRDICT } from '@/lib/site-logic';
import type { Lang, UIKey } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';

/**
 * Practice, first row: the outside study tools she recommends as three cards. The dictionary card
 * searches krdict right away (a form, new tab) with a link to the site; pronunciation and news are
 * one link each, in a new tab: icon, name, what it is, a tag and the action. (Copy keys keep their
 * `home.links.*` names from when this block was on the home page.)
 */
interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const k = (key: string, part = '') => `home.links.${key}${part}` as UIKey;
---

<div class="container-page practice-tools">
  <ul class="tool-cards" data-study-tools>
    {QUICK_LINKS.map((link) =>
      link.key === 'dictionary' ? (
        <li>
          <!-- The dictionary searches right here: a form to krdict (new tab), the site link below. -->
          <div class="tool-card tool-card-search">
            <Shape name={link.shape} tone={link.tone} texture="hatch" class="tool-shape" />
            <span class="tool-icon">
              <Icon name={link.icon} />
            </span>
            <span class="tool-name">{t(k(link.key))}</span>
            <span class="tool-text">{t(k(link.key, '.text'))}</span>
            <form class="dictionary-form" action={KRDICT.action} method="get" target="_blank">
              {Object.entries(KRDICT.hidden).map(([name, value]) => (
                <input type="hidden" name={name} value={value} />
              ))}
              <label for="dict-q" class="sr-only">
                {t('practice.dictionaryField')}
              </label>
              <input
                id="dict-q"
                class="field"
                type="search"
                name={KRDICT.field}
                lang="ko"
                required
                placeholder="자유"
              />
              <button type="submit" class="btn btn-primary">
                {t('practice.dictionaryGo')}
              </button>
            </form>
            <span class="tool-foot">
              <span class="tool-tag">{t(k(link.key, '.tag'))}</span>
              <a class="tool-action" href={link.href} target="_blank" rel="noopener noreferrer">
                {t(k(link.key, '.action'))}
                <span class="sr-only">({t('home.links.newTab')})</span>
              </a>
            </span>
          </div>
        </li>
      ) : (
        <li>
          <a
            class="tool-card card-interactive"
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Shape
              name={link.shape}
              tone={link.tone}
              texture="hatch"
              class="tool-shape card-shape"
            />
            <span class="tool-icon">
              <Icon name={link.icon} />
            </span>
            <span class="tool-name">
              {t(k(link.key))}
              <Icon name="arrow-up-right" class="tool-out" />
            </span>
            <span class="tool-text">{t(k(link.key, '.text'))}</span>
            <span class="tool-foot">
              <span class="tool-tag">{t(k(link.key, '.tag'))}</span>
              <span class="tool-action">{t(k(link.key, '.action'))}</span>
            </span>
            <span class="sr-only">({t('home.links.newTab')})</span>
          </a>
        </li>
      ),
    )}
  </ul>
</div>
