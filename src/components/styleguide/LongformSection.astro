---
import { Content as Lesson } from './samples/lesson.md';
import SgSection from './SgSection.astro';
---

<SgSection
  id="longform"
  title="Long-form text"
  shape="arch"
  lead="Any lesson or article written in Markdown, wrapped in .prose. The sample below is a real Markdown file, so this also checks the Markdown pipeline (tables get a scroll wrapper)."
>
  <article class="prose">
    <Lesson />
  </article>
</SgSection>
