---
import '@fontsource-variable/outfit';
// Cyrillic (Ukrainian): Outfit has no Cyrillic. Only Manrope's Cyrillic file, declared inline below
// with its unicode-range, so Latin and Korean pages never download it and the shared CSS stays small.
import manropeCyrillicUrl from '@fontsource-variable/manrope/files/manrope-cyrillic-wght-normal.woff2?url';
import outfitLatinUrl from '@fontsource-variable/outfit/files/outfit-latin-wght-normal.woff2?url';
import 'pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css';
// Korean serif (명조): only the slices holding the display glyphs (npm run fonts).
import '@/styles/display-font.css';
import '@/styles/global.css';

import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import ThemeScript from '@/components/ThemeScript.astro';
import { SITE } from '@/config';
import { LOCALES } from '@/i18n/locales';
import { defaultLang, languages, type Lang } from '@/i18n/ui';
import { getLangFromUrl, switchLocalePath, useTranslations } from '@/i18n/utils';

interface Props {
  /** Page title without the site name. Omit on the home page. */
  title?: string;
  description?: string;
  /** Set for pages that should not be indexed (e.g. 404). */
  noindex?: boolean;
  /** Page exists in one language only: no hreflang alternates, no language switch. */
  monolingual?: boolean;
  /** Share image (1200×630) instead of the default one, e.g. a lesson cover. */
  image?: { src: string; alt: string };
}

const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const {
  title,
  description = t('site.description'),
  noindex = false,
  monolingual = false,
  image,
} = Astro.props;
const showAlternates = !noindex && !monolingual;
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · ${t('site.tagline')}`;

const site = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, site).href;
const alternates = (Object.keys(languages) as Lang[]).map((l) => ({
  lang: l,
  href: new URL(switchLocalePath(Astro.url, l), site).href,
}));
const xDefault = alternates.find((a) => a.lang === defaultLang)!.href;
const ogLocale = LOCALES[lang].og;
// Share image: the page's own, else the default one rendered by `npm run icons`.
const ogImage = new URL(image?.src ?? '/og-default.png', site).href;
const ogImageAlt = image?.alt ?? t('site.ogImageAlt');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeScript />
    <!-- Preload the Latin UI font so text does not render in a fallback and then shift. -->
    <link rel="preload" href={outfitLatinUrl} as="font" type="font/woff2" crossorigin />
    <style
      is:inline
      set:html={`@font-face{font-family:'Manrope Variable';font-style:normal;font-display:swap;font-weight:200 800;src:url(${manropeCyrillicUrl}) format('woff2-variations');unicode-range:U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116}`}
    ></style>

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {showAlternates &&
      alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    {showAlternates && <link rel="alternate" hreflang="x-default" href={xDefault} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#fbfbfd" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111733" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="flex min-h-dvh flex-col bg-bg text-text antialiased">
    <a
      href="#main"
      data-print="hide"
      class="sr-only z-50 rounded-control bg-brand-strong px-4 py-3 font-semibold text-on-brand focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      {t('a11y.skipToContent')}
    </a>
    <Header lang={lang} showLanguageSwitch={!monolingual} />
    <slot name="before-main" />
    <main id="main" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
