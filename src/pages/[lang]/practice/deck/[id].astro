---
import type { GetStaticPaths } from 'astro';
import { getDecks } from '@/content/queries';
import { langItemPaths } from '@/i18n/routes';
import DeckView from '@/views/DeckView.astro';

export const getStaticPaths = (async () =>
  langItemPaths(await getDecks(), 'deck')) satisfies GetStaticPaths;
const { lang, deck } = Astro.props;
---

<DeckView lang={lang} deck={deck} />
