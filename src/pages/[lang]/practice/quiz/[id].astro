---
import type { GetStaticPaths } from 'astro';
import { getQuizzes } from '@/content/queries';
import { langItemPaths } from '@/i18n/routes';
import QuizView from '@/views/QuizView.astro';

export const getStaticPaths = (async () =>
  langItemPaths(await getQuizzes(), 'quiz')) satisfies GetStaticPaths;
const { lang, quiz } = Astro.props;
---

<QuizView lang={lang} quiz={quiz} />
