---
/**
 * DEMO ONLY — site guide: in plain words, what can be added to the site through Pages CMS, and
 * (second tab) the design system. Reached only from the footer. English-only like the styleguide:
 * exempt from the i18n dictionary rule; noindex, not in the sitemap.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHead from '@/components/PageHead.astro';
import GuideTabs from '@/components/guide/GuideTabs.astro';

const FORMS = [
  {
    name: 'Lessons',
    what: 'One lesson, usually one YouTube video. The main thing on the site.',
    where: [
      ['Lessons', '/lessons/'],
      ['Home', '/'],
    ],
    fill: [
      'Title, date, level',
      'YouTube link (optional)',
      'Playlist and a one-line summary',
      'Grammar patterns, e.g. -게',
      'Text or transcript',
    ],
    extra: 'Optional words, a quiz and files of its own: they also show on Practice and Materials.',
  },
  {
    name: 'Words',
    what: 'A set of flashcards on a topic that is not tied to one lesson.',
    where: [['Practice → Flashcards', '/practice/flashcards/']],
    fill: ['Title, level', 'Words: Korean, meaning, example'],
  },
  {
    name: 'Quizzes',
    what: 'A short test on a topic that is not tied to one lesson.',
    where: [['Practice → Quizzes', '/practice/quizzes/']],
    fill: ['Title, level', 'Questions: multiple choice or fill in the gap'],
  },
  {
    name: 'Materials',
    what: 'A file to download: worksheet, notes, transcript, audio.',
    where: [['Materials', '/materials/']],
    fill: ['Title, date', 'Tab: class, podcast or self-study', 'Type: reading, writing…', 'Links'],
  },
  {
    name: 'Notices',
    what: 'A short line in the strip at the top of every page.',
    where: [['Top of every page', '/']],
    fill: ['Title and one line', 'Show from / until', 'Colour: important, news or info'],
    extra: 'It appears and disappears by its dates on its own.',
  },
  {
    name: 'Site settings',
    what: 'Links used across the site.',
    where: [['Header and footer', '/']],
    fill: ['TidyCal booking', 'Tally forms', 'YouTube, Instagram, Ko-fi'],
  },
];

const NOT_IN_CMS = [
  'Classes page (formats, prices, FAQ)',
  'About page text and photo',
  'The list of playlists',
  'Translations of the menus and pages',
];
---

<BaseLayout title="Site guide" noindex monolingual>
  <PageHead
    eyebrow="Site guide"
    title="What you can add"
    lead="Everything is added in Pages CMS. There are six forms, and none depends on another: fill one in, save, and it shows up on the site after the next build."
  >
    <GuideTabs current="content" />
  </PageHead>

  <div class="container-page">
    <ol class="guide-forms">
      {FORMS.map((form) => (
        <li class="guide-form">
          <div>
            <h2 class="guide-form-name">{form.name}</h2>
            <p class="guide-where">
              {form.where.map(([label, href], i) => (
                <>
                  {i > 0 && ' · '}
                  <a class="link" href={href}>
                    {label}
                  </a>
                </>
              ))}
            </p>
          </div>
          <div>
            <p class="guide-what">{form.what}</p>
            <ul class="guide-fill">
              {form.fill.map((f) => (
                <li>{f}</li>
              ))}
            </ul>
            {form.extra && <p class="guide-extra">{form.extra}</p>}
          </div>
        </li>
      ))}
    </ol>

    <div class="guide-notes">
      <section>
        <h2 class="page-section-title">Files</h2>
        <p>Upload the PDF or audio to R2 first, then paste its link into the form.</p>
      </section>
      <section>
        <h2 class="page-section-title">Not in the CMS</h2>
        <p>These change rarely, so they live in the code. Ask the developer:</p>
        <ul class="guide-fill">
          {NOT_IN_CMS.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>
