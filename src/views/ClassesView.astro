---
/**
 * Classes: the three formats as distinct cards (who it is for, a few facts, its own button), how
 * to start, FAQ, and a closing block for those not sure which format fits. Content is hardcoded in src/data/classes.ts (this page changes rarely).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getSite } from '@/content/queries';
import { CLASSES } from '@/data/classes';
import { pick } from '@/i18n/localized';
import type { Lang } from '@/i18n/ui';
import { localizePath, useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const site = await getSite();
const { formats: FORMATS, steps: STEPS, faq: FAQ } = pick(CLASSES, lang);
// Tally form when set; until then the demo contact page.
const contact = site.contactForm || localizePath(lang, 'contact');
const external = (href: string) =>
  href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<BaseLayout title={t('page.classes.title')}>
  <div class="container-page page-head">
    <h1 class="page-title">{t('page.classes.title')}</h1>
    <p class="page-lead">{t('classes.lead')}</p>
  </div>

  <section class="container-page page-section" aria-labelledby="formats-title">
    <h2 id="formats-title" class="sr-only">
      {t('classes.formats')}
    </h2>
    <div class="formats">
      {FORMATS.map((format, i) => {
        const href = format.action === 'book' && site.tidycal ? site.tidycal : contact;
        return (
          <article class="format" data-format={i + 1} aria-labelledby={`format-${i}`}>
            {/* People taking part, as dots: decorative, the line below says it in words. */}
            <span class="format-people" aria-hidden="true">
              {Array.from({ length: format.people }, () => (
                <i />
              ))}
            </span>
            <h3 id={`format-${i}`} class="format-name">
              {format.name}
            </h3>
            <p class="format-for">{format.forWhom}</p>
            <dl class="format-facts">
              {format.facts.map((fact) => (
                <div>
                  <dt>{fact.label}</dt>
                  <dd>{fact.value}</dd>
                </div>
              ))}
            </dl>
            <p class="format-how">{format.how}</p>
            <a
              class:list={[
                'btn',
                format.action === 'book' ? 'btn-primary' : 'btn-ghost',
                'format-action',
              ]}
              href={href}
              {...external(href)}
              data-book-class={format.action === 'book' && site.tidycal ? '' : undefined}
            >
              {format.action === 'book' ? t('home.bookClass') : t('classes.ask')}
              <span class="sr-only">: {format.name}</span>
            </a>
          </article>
        );
      })}
    </div>
  </section>

  <section class="container-page page-section" aria-labelledby="steps-title">
    <h2 id="steps-title" class="page-section-title">
      {t('classes.steps')}
    </h2>
    <ol class="steps">
      {STEPS.map((step, i) => (
        <li class="step">
          <span class="step-number" aria-hidden="true">
            {i + 1}
          </span>
          <h3 class="step-title">{step.title}</h3>
          <p class="step-text">{step.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="container-page page-section" aria-labelledby="faq-title">
    <h2 id="faq-title" class="page-section-title">
      {t('classes.faq')}
    </h2>
    <div class="faq-list">
      {FAQ.map((item) => (
        <details class="faq-item">
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="container-page page-section" aria-labelledby="cta-title">
    <div class="classes-cta grid-paper" data-classes-cta>
      <div>
        <h2 id="cta-title" class="page-section-title">
          {t('classes.ready')}
        </h2>
        <p class="classes-cta-text">{t('classes.readyText')}</p>
      </div>
      <a class="btn btn-primary" href={contact} {...external(contact)}>
        {t('classes.contact')}
      </a>
    </div>
  </section>
</BaseLayout>
