---
/**
 * Contact: JiEun's Tally form, shown inside the page (Site settings → Contact form). Until that
 * link is set, a demo form that validates in the browser and sends nothing.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Lang } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';
import { getSite } from '@/content/queries';
import { tallyEmbedUrl } from '@/lib/site-logic';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const site = await getSite();
const tally = site.contactForm ? tallyEmbedUrl(site.contactForm) : '';
---

<BaseLayout title={t('page.contact.title')}>
  <div class="container-page page-head">
    <p class="eyebrow mb-4">{tally ? t('home.classes.eyebrow') : t('contact.demo')}</p>
    <h1 class="page-title">{t('page.contact.title')}</h1>
    <p class="page-lead">{t('contact.lead')}</p>
  </div>

  <section class="container-page page-section">
    {tally ? (
      <div class="contact-embed">
        <div class="contact-sheet">
          {/* Tally's embed code (Share → Embed), as given; only the title comes from the dictionary. */}
          <iframe
            data-tally-src={tally}
            loading="lazy"
            width="100%"
            height="200"
            frameborder="0"
            marginheight="0"
            marginwidth="0"
            title={t('page.contact.title')}
          />
        </div>
        <p class="contact-alt" data-print="hide">
          <a href={site.contactForm} target="_blank" rel="noopener noreferrer">
            {t('contact.openForm')}
          </a>
        </p>
      </div>
    ) : (
      <form class="contact-form" data-demo-form>
        <div class="contact-row">
          <div class="contact-field">
            <label for="contact-name">{t('contact.name')}</label>
            <input id="contact-name" name="name" class="field" autocomplete="name" required />
          </div>
          <div class="contact-field">
            <label for="contact-email">{t('contact.email')}</label>
            <input
              id="contact-email"
              name="email"
              type="email"
              class="field"
              autocomplete="email"
              required
            />
          </div>
        </div>
        <div class="contact-field">
          <label for="contact-topic">{t('contact.topic')}</label>
          <select id="contact-topic" name="topic" class="field" required>
            <option value="">{t('contact.topicChoose')}</option>
            <option value="classes">{t('contact.topicClasses')}</option>
            <option value="materials">{t('contact.topicMaterials')}</option>
            <option value="other">{t('contact.topicOther')}</option>
          </select>
        </div>
        <div class="contact-field">
          <label for="contact-message">{t('contact.message')}</label>
          <textarea id="contact-message" name="message" class="field" rows="6" required />
        </div>
        <div class="contact-actions">
          <button type="submit" class="btn btn-primary">
            {t('contact.send')}
          </button>
          <p class="contact-status" role="status" data-demo-status />
        </div>
      </form>
    )}
  </section>
</BaseLayout>

{tally ? (
  <>
    {/* Tally's embed script loader, as given in its embed code: it loads the form and keeps the
        frame as tall as the form. The only outside script on the site. */}
    <script is:inline>
      var d = document,
        w = 'https://tally.so/widgets/embed.js',
        v = function () {
          'undefined' != typeof Tally
            ? Tally.loadEmbeds()
            : d.querySelectorAll('iframe[data-tally-src]:not([src])').forEach(function (e) {
                e.src = e.dataset.tallySrc;
              });
        };
      if ('undefined' != typeof Tally) v();
      else if (d.querySelector('script[src="' + w + '"]') == null) {
        var s = d.createElement('script');
        ((s.src = w), (s.onload = v), (s.onerror = v), d.body.appendChild(s));
      }
    </script>
  </>
) : (
  <script is:inline define:vars={{ note: t('contact.demoSent') }}>
    document.querySelector('[data-demo-form]')?.addEventListener('submit', (event) => {
      // Demo: the browser has already checked the fields; nothing is sent anywhere.
      event.preventDefault();
      document.querySelector('[data-demo-status]').textContent = note;
    });
  </script>
)}
