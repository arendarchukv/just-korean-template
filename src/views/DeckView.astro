---
/** One flashcard deck in the practice studio: every deck listed on the left, this one open. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Flashcards from '@/components/widgets/Flashcards.svelte';
import { getDecks } from '@/content/queries';
import PracticeStudio from '@/components/PracticeStudio.astro';
import type { Lang, UIKey } from '@/i18n/ui';
import { localizePath, useTranslations } from '@/i18n/utils';

type Deck = Awaited<ReturnType<typeof getDecks>>[number];
interface Props {
  lang: Lang;
  deck: Deck;
}

const { lang, deck } = Astro.props;
const t = useTranslations(lang);
const decks = await getDecks();
const labels = {
  flipHint: t('deck.flipHint'),
  meaning: t('deck.meaning'),
  know: t('deck.know'),
  again: t('deck.again'),
  position: t('deck.position'),
  knownCount: t('deck.knownCount'),
  done: t('deck.done'),
  rest: t('deck.rest'),
  restart: t('deck.restart'),
};
---

<BaseLayout title={deck.title} description={deck.description}>
  <PracticeStudio
    kind="deck"
    units={decks.map((d) => ({ ...d, count: d.cards.length }))}
    currentId={deck.id}
    lang={lang}
  >
    <div class="studio-head">
      <p class="studio-crumb">
        <a class="link" href={localizePath(lang, 'practice')}>
          {t('page.practice.title')}
        </a>{' '}
        · {t('practice.decks')} · {t(`grammar.level.${deck.level}` as UIKey)}
      </p>
      <h1 class="studio-title">{deck.title}</h1>
      {deck.description && <p class="studio-lead">{deck.description}</p>}
      {deck.lessonEntry && (
        <p class="widget-lesson">
          {t('widget.fromLesson')}{' '}
          <a class="link" href={localizePath(lang, `lessons/${deck.lessonEntry.id}`)}>
            {deck.lessonEntry.title}
          </a>
        </p>
      )}
    </div>
    <Flashcards client:visible deckId={deck.id} cards={deck.cards} labels={labels} />
    <noscript>
      <!-- Without JS the widget cannot work: show only the readable list. -->
      <style>
        .widget {
          display: none;
        }
      </style>
      <ol class="widget-fallback">
        {deck.cards.map((card) => (
          <li>
            <span lang="ko">{card.front}</span> — {card.back}
          </li>
        ))}
      </ol>
    </noscript>
  </PracticeStudio>
</BaseLayout>
