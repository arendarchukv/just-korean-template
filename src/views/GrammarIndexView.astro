---
/**
 * Grammar: the patterns typed as tags on lessons, A→Z in Korean order, each with the lessons that
 * explain it. Not in the menu; lesson pages link here. The filter is a small inline script; without
 * JS the full list.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHead from '@/components/PageHead.astro';
import { getGrammarTags } from '@/content/queries';
import type { Lang } from '@/i18n/ui';
import { localizePath, useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const tags = await getGrammarTags();
---

<BaseLayout title={t('page.grammar.title')}>
  <PageHead
    eyebrow={t('page.grammar.eyebrow')}
    title={t('page.grammar.title')}
    lead={t('grammar.lead')}
  >
    <div class="grammar-search" data-grammar-search hidden>
      <label for="grammar-q" class="sr-only">
        {t('grammar.search')}
      </label>
      <input
        id="grammar-q"
        type="search"
        class="field"
        placeholder={t('grammar.searchHint')}
        autocomplete="off"
      />
      <p role="status" class="grammar-status" data-no-results={t('grammar.noResults')}></p>
    </div>
  </PageHead>
  <section
    class="container-page page-section"
    data-grammar-group
    aria-label={t('page.grammar.title')}
  >
    <ul class="pattern-list">
      {tags.map((g) => (
        <li id={g.slug} class="pattern-row" data-search={g.tag.toLowerCase()}>
          <span class="pattern-name" lang="ko">
            {g.tag}
          </span>
          <ul class="pattern-lessons">
            {g.lessons.map((l) => (
              <li>
                <a class="link" href={localizePath(lang, `lessons/${l.id}`)}>
                  {l.title}
                </a>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ul>
  </section>
  <script is:inline>
    (() => {
      const box = document.querySelector('[data-grammar-search]');
      if (!box) return;
      box.hidden = false;
      const input = box.querySelector('input');
      const status = box.querySelector('[role="status"]');
      const filter = () => {
        const q = input.value.trim().toLowerCase();
        let total = 0;
        for (const group of document.querySelectorAll('[data-grammar-group]')) {
          let shown = 0;
          for (const li of group.querySelectorAll('[data-search]')) {
            const match = !q || li.dataset.search.includes(q);
            li.hidden = !match;
            if (match) shown += 1;
          }
          group.hidden = shown === 0;
          total += shown;
        }
        status.textContent = total === 0 ? status.dataset.noResults : '';
      };
      // While Hangul is being composed the field holds a bare jamo: wait for the syllable.
      input.addEventListener('input', (event) => {
        if (!event.isComposing) filter();
      });
      input.addEventListener('compositionend', filter);
      // A value restored by the browser (back/forward) arrives after this script runs:
      // apply it once the page is shown.
      window.addEventListener('pageshow', () => {
        if (input.value) filter();
      });
    })();
  </script>
</BaseLayout>
