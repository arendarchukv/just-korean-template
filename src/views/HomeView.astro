---
/** Home page, shared by `/` and `/ko/`. Content comes from src/content; copy from i18n. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import AboutHero from '@/components/home/AboutHero.astro';
import ClassesTable from '@/components/home/ClassesTable.astro';
import NewLessons from '@/components/home/NewLessons.astro';
import NoticeStrip from '@/components/home/NoticeStrip.astro';
import QuickLinks from '@/components/home/QuickLinks.astro';
import { validateContent } from '@/content/queries';
import type { Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
// The home page always builds, so this is where colliding practice pages stop the build.
await validateContent();
---

<BaseLayout>
  <NoticeStrip lang={lang} slot="before-main" />
  <AboutHero lang={lang} />
  <QuickLinks lang={lang} />
  <ClassesTable lang={lang} />
  <NewLessons lang={lang} />
</BaseLayout>
