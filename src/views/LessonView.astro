---
/** Lesson page: player, text, grammar tags, its own files, words and quiz, playlist navigation. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import VideoFacade from '@/components/VideoFacade.astro';
import Icon from '@/components/Icon.astro';
import LevelBadge from '@/components/learn/LevelBadge.astro';
import { getLessons, renderBody, type Lesson } from '@/content/queries';
import type { Lang, UIKey } from '@/i18n/ui';
import { playlistText } from '@/data/playlists';
import { dateFormat, localizePath, useTranslations } from '@/i18n/utils';
import { neighbours, sortInPlaylist, tagSlug } from '@/lib/site-logic';

interface Props {
  lang: Lang;
  lesson: Lesson;
}
const { lang, lesson } = Astro.props;
const t = useTranslations(lang);
const Body = await renderBody(lesson.id);
const all = await getLessons();
const playlist = lesson.playlistEntry;
const playlistTitle = playlist && playlistText(playlist, lang).title;
const seriesLessons = playlist
  ? sortInPlaylist(
      all.filter((l) => l.playlist === playlist.id),
      playlist.kind,
    )
  : [];
const { prev, next } = neighbours(seriesLessons, lesson.id);
const isCourse = playlist?.kind === 'course';
const position = seriesLessons.findIndex((l) => l.id === lesson.id) + 1;
const dates = dateFormat(lang);
// The lesson's own words and quiz have their pages under its id (see getDecks / getQuizzes).
const hasWords = lesson.words.length > 0;
const hasQuiz = lesson.quiz.length > 0;
const href = (id: string) => localizePath(lang, `lessons/${id}`);
const kind = (k: string) => t(`lesson.kind.${k}` as UIKey);
---

<BaseLayout title={lesson.title} description={lesson.summary}>
  <div class="container-page lesson-layout">
    <article class="lesson-main">
      {lesson.youtube && <VideoFacade id={lesson.youtube} title={lesson.title} lang={lang} />}
      <header class="lesson-head">
        {playlist && (
          <p class="lesson-kicker">
            <a class="section-eyebrow" href={`${localizePath(lang, 'lessons')}#${playlist.id}`}>
              {playlistTitle}
            </a>
            {isCourse && (
              <span class="lesson-position">
                {t('lesson.position')
                  .replace('{n}', String(position))
                  .replace('{total}', String(seriesLessons.length))}
              </span>
            )}
          </p>
        )}
        <h1 class="lesson-heading">{lesson.title}</h1>
        {lesson.summary && <p class="page-lead">{lesson.summary}</p>}
        <div class="lesson-meta-row" data-lesson-meta>
          <LevelBadge level={lesson.level} label={t(`grammar.level.${lesson.level}` as UIKey)} />
          <time datetime={lesson.date.toISOString().slice(0, 10)}>{dates.format(lesson.date)}</time>
          {lesson.youtube && (
            <a
              class="lesson-youtube"
              href={`https://www.youtube.com/watch?v=${lesson.youtube}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name="youtube" />
              {t('lesson.watchOnYouTube')}
              <Icon name="arrow-up-right" class="lesson-youtube-out" />
            </a>
          )}
        </div>
      </header>
      <div class="prose">
        <Body />
      </div>

      {lesson.grammar.length > 0 && (
        <section class="lesson-block" aria-labelledby="lesson-grammar">
          <h2 id="lesson-grammar" class="lesson-block-title">
            {t('lesson.grammar')}
          </h2>
          <ul class="chip-list">
            {lesson.grammar.map((tag) => (
              <li>
                <a
                  class="pattern-chip"
                  lang="ko"
                  href={`${localizePath(lang, 'grammar')}#${tagSlug(tag)}`}
                >
                  {tag}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {(hasWords || hasQuiz) && (
        <section class="lesson-block" aria-labelledby="lesson-practice">
          <h2 id="lesson-practice" class="lesson-block-title">
            {t('lesson.practice')}
          </h2>
          <ul class="lesson-tiles">
            {hasWords && (
              <li>
                <a class="lesson-tile" href={localizePath(lang, `practice/deck/${lesson.id}`)}>
                  <Icon name="cards" class="lesson-tile-icon" />
                  <span class="lesson-tile-text">
                    <span class="lesson-tile-title">{t('lesson.deck')}</span>
                    <span class="lesson-tile-sub">
                      {lesson.words.length} {t('lesson.cards')}
                    </span>
                  </span>
                  <Icon name="arrow" class="lesson-tile-arrow" />
                </a>
              </li>
            )}
            {hasQuiz && (
              <li>
                <a class="lesson-tile" href={localizePath(lang, `practice/quiz/${lesson.id}`)}>
                  <Icon name="quiz" class="lesson-tile-icon" />
                  <span class="lesson-tile-text">
                    <span class="lesson-tile-title">{t('lesson.quiz')}</span>
                    <span class="lesson-tile-sub">
                      {lesson.quiz.length} {t('lesson.questions')}
                    </span>
                  </span>
                  <Icon name="arrow" class="lesson-tile-arrow" />
                </a>
              </li>
            )}
          </ul>
        </section>
      )}

      {lesson.files.length > 0 && (
        <section class="lesson-block" aria-labelledby="lesson-files">
          <h2 id="lesson-files" class="lesson-block-title">
            {t('lesson.files')}
          </h2>
          <ul class="lesson-tiles">
            {lesson.files.map((f) => (
              <li>
                <a class="lesson-tile" href={f.url} target="_blank" rel="noopener noreferrer">
                  <span class="file-kind">{kind(f.kind)}</span>
                  <span class="lesson-tile-text">
                    <span class="lesson-tile-title">{f.label}</span>
                  </span>
                  <Icon name="arrow-up-right" class="lesson-tile-arrow" />
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {(prev || next) && (
        <nav class="lesson-pager" aria-label={t('lesson.series')}>
          {prev && (
            <a class="pager-link" href={href(prev.id)} rel="prev">
              <span class="pager-label">{t('lesson.prev')}</span>
              <span class="pager-title">{prev.title}</span>
            </a>
          )}
          {next && (
            <a class="pager-link pager-next" href={href(next.id)} rel="next">
              <span class="pager-label">{t('lesson.next')}</span>
              <span class="pager-title">{next.title}</span>
            </a>
          )}
        </nav>
      )}
    </article>

    {seriesLessons.length > 1 && (
      <aside class="lesson-aside" aria-labelledby="lesson-series-title">
        <div class="lesson-aside-head">
          <h2 id="lesson-series-title" class="lesson-aside-title">
            {playlistTitle}
          </h2>
          <p class="lesson-aside-count">
            {t('lessons.count').replace('{total}', String(seriesLessons.length))}
          </p>
        </div>
        <ol class="series-list">
          {seriesLessons.map((l, i) => (
            <li>
              <a href={href(l.id)} aria-current={l.id === lesson.id ? 'page' : undefined}>
                {isCourse && <span class="series-number">{String(i + 1).padStart(2, '0')}</span>}
                <span>{l.title}</span>
              </a>
            </li>
          ))}
        </ol>
        <script is:inline>
          // The list scrolls inside its box: bring the current lesson into view (never the page).
          (() => {
            const list = document.querySelector('.series-list');
            const current = list?.querySelector('[aria-current="page"]');
            if (!list || !current || list.scrollHeight <= list.clientHeight) return;
            const top = current.offsetTop - list.offsetTop;
            list.scrollTop = top - list.clientHeight / 2 + current.offsetHeight / 2;
          })();
        </script>
      </aside>
    )}
  </div>
</BaseLayout>
