---
/**
 * Lessons library: every lesson as the same card in one grid, newest first. Above it a playlist
 * choice (All · each playlist), level and format (with or without a video) filters and a search over titles, summaries and grammar
 * patterns; 24 cards a page, with the Materials pager. A course, once chosen, reads oldest first; its cards
 * carry "Lesson 3" everywhere. The view lives in the address (`?playlist=grammar&level=…&q=…&page=2`),
 * so Back from a lesson returns to it and the lesson page can link to its playlist. When nothing
 * matches, one button clears the filters. Without JS: the full grid, no controls.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import LessonCard from '@/components/LessonCard.astro';
import PageHead from '@/components/PageHead.astro';
import { getLessons, getPlaylists } from '@/content/queries';
import type { Lang, UIKey } from '@/i18n/ui';
import { playlistText } from '@/data/playlists';
import { useTranslations } from '@/i18n/utils';
import { sortInPlaylist } from '@/lib/site-logic';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const lessons = sortInPlaylist(await getLessons(), 'library');
const playlists = getPlaylists()
  .map((p) => ({
    ...p,
    ...playlistText(p, lang),
    lessons: lessons.filter((l) => l.playlist === p.id),
  }))
  .filter((p) => p.lessons.length > 0);
const LEVELS = ['beginner', 'intermediate', 'advanced'] as const;
const FORMATS = ['video', 'text'] as const;
---

<BaseLayout title={t('page.lessons.title')}>
  <PageHead
    eyebrow={t('page.lessons.eyebrow')}
    title={t('page.lessons.title')}
    lead={t('lessons.lead')}
  />

  <div
    class="container-page lessons"
    data-lessons
    data-page-size="24"
    data-label-count={t('lessons.count')}
    data-label-prev={t('pager.prev')}
    data-label-next={t('pager.next')}
    data-label-page={t('pager.page')}
    data-label-showing={t('pager.showing')}
  >
    <div class="lessons-tools" data-lessons-tools hidden>
      <div class="lesson-chips" role="radiogroup" aria-label={t('lessons.filterPlaylist')}>
        <label class="lesson-chip">
          <input type="radio" name="playlist" value="" checked data-lessons-playlist />
          <span>
            {t('lessons.all')} <span class="lesson-chip-count">{lessons.length}</span>
          </span>
        </label>
        {playlists.map((p) => (
          <label class="lesson-chip">
            <input
              type="radio"
              name="playlist"
              value={p.id}
              data-course={p.kind === 'course' ? '' : undefined}
              data-lessons-playlist
            />
            <span>
              {p.title} <span class="lesson-chip-count">{p.lessons.length}</span>
            </span>
          </label>
        ))}
      </div>
      <div class="mat-tools">
        <label class="mat-tool">
          <span class="sr-only">{t('lessons.filterLevel')}</span>
          <select class="field" data-lessons-level>
            <option value="">{t('lessons.allLevels')}</option>
            {LEVELS.map((k) => (
              <option value={k}>{t(`grammar.level.${k}` as UIKey)}</option>
            ))}
          </select>
        </label>
        <label class="mat-tool">
          <span class="sr-only">{t('lessons.filterFormat')}</span>
          <select class="field" data-lessons-format>
            <option value="">{t('lessons.allFormats')}</option>
            {FORMATS.map((k) => (
              <option value={k}>{t(`lessons.format.${k}` as UIKey)}</option>
            ))}
          </select>
        </label>
        <label class="mat-tool mat-search">
          <span class="sr-only">{t('lessons.search')}</span>
          <input
            type="search"
            class="field"
            placeholder={t('lessons.search')}
            autocomplete="off"
            data-lessons-search
          />
        </label>
      </div>
    </div>

    {playlists.map((p) => (
      <div class="lessons-about" data-lessons-about={p.id} hidden>
        <p>{p.description}</p>
        {p.youtube && (
          <a class="link" href={p.youtube} target="_blank" rel="noopener noreferrer">
            {t('lessons.playlist')}
          </a>
        )}
      </div>
    ))}

    <p
      class="lessons-status"
      role="status"
      data-lessons-status
      data-none={t('lessons.noResults')}
    ></p>
    <div class="lessons-empty" data-lessons-empty hidden>
      <button type="button" class="btn btn-ghost" data-lessons-clear>
        {t('lessons.clear')}
      </button>
    </div>

    <ul class="lesson-row lessons-grid" data-lessons-grid>
      {lessons.map((l) => (
        <li
          data-playlist={l.playlist ?? ''}
          data-level={l.level}
          data-format={l.youtube ? 'video' : 'text'}
          data-date={l.date.toISOString()}
          data-search={[l.title, l.summary ?? '', ...l.grammar].join(' ').toLowerCase()}
        >
          <LessonCard lesson={l} lang={lang} />
        </li>
      ))}
    </ul>

    {/* The same pager as Materials (its styles). */}
    <nav class="mat-pager" data-lessons-pager aria-label={t('pager.pages')} hidden>
      <p class="mat-pager-status" data-pager-showing></p>
      <div class="mat-pager-buttons" data-pager-pages></div>
    </nav>
  </div>

  <script is:inline>
    (() => {
      const root = document.querySelector('[data-lessons]');
      if (!root) return;
      const grid = root.querySelector('[data-lessons-grid]');
      const items = [...grid.children];
      const radios = [...root.querySelectorAll('[data-lessons-playlist]')];
      const level = root.querySelector('[data-lessons-level]');
      const format = root.querySelector('[data-lessons-format]');
      const search = root.querySelector('[data-lessons-search]');
      const status = root.querySelector('[data-lessons-status]');
      const pager = root.querySelector('[data-lessons-pager]');
      const empty = root.querySelector('[data-lessons-empty]');
      const size = Number(root.dataset.pageSize) || 24;
      let page = 1;
      root.querySelector('[data-lessons-tools]').hidden = false;
      const fill = (text, values) => text.replace(/\{(\w+)\}/g, (_, k) => String(values[k]));
      const button = (label, onClick, { current, disabled, text } = {}) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'mat-page';
        b.textContent = text ?? label;
        b.setAttribute('aria-label', label);
        if (current) b.setAttribute('aria-current', 'page');
        b.disabled = Boolean(disabled);
        b.addEventListener('click', onClick);
        return b;
      };
      /** Page numbers to show: all when few, else first, last and the ones around the current. */
      const pageList = (count) => {
        if (count <= 7) return Array.from({ length: count }, (_, i) => i + 1);
        const keep = new Set([1, count, page - 1, page, page + 1]);
        const list = [];
        for (let n = 1; n <= count; n++) {
          if (keep.has(n)) list.push(n);
          else if (list.at(-1) !== '…') list.push('…');
        }
        return list;
      };

      /** The view in the address: playlist, level, search and page (only what is set). */
      const writeAddress = (playlist, lvl, fmt, q) => {
        const params = new URLSearchParams();
        if (playlist) params.set('playlist', playlist);
        if (lvl) params.set('level', lvl);
        if (fmt) params.set('format', fmt);
        if (q) params.set('q', q);
        if (page > 1) params.set('page', String(page));
        const query = params.toString();
        history.replaceState(null, '', query ? `?${query}` : location.pathname);
      };
      const readAddress = () => {
        const params = new URLSearchParams(location.search);
        const chosen = radios.find((r) => r.value === (params.get('playlist') ?? ''));
        (chosen ?? radios[0]).checked = true;
        const lvl = params.get('level') ?? '';
        level.value = [...level.options].some((o) => o.value === lvl) ? lvl : '';
        const fmt = params.get('format') ?? '';
        format.value = [...format.options].some((o) => o.value === fmt) ? fmt : '';
        search.value = params.get('q') ?? '';
        page = Math.max(1, Number.parseInt(params.get('page') ?? '1', 10) || 1);
      };

      const update = (keepPage = false) => {
        if (!keepPage) page = 1;
        const chosen = radios.find((r) => r.checked);
        const playlist = chosen?.value ?? '';
        const lvl = level.value;
        const fmt = format.value;
        const query = search.value.trim();
        const q = query.toLowerCase();
        for (const about of root.querySelectorAll('[data-lessons-about]')) {
          about.hidden = about.dataset.lessonsAbout !== playlist;
        }
        // A course reads oldest first; everything else newest first.
        const course = chosen?.hasAttribute('data-course');
        const sorted = [...items].sort((a, b) =>
          course
            ? a.dataset.date.localeCompare(b.dataset.date)
            : b.dataset.date.localeCompare(a.dataset.date),
        );
        grid.replaceChildren(...sorted);
        const matches = sorted.filter(
          (li) =>
            (!playlist || li.dataset.playlist === playlist) &&
            (!lvl || li.dataset.level === lvl) &&
            (!fmt || li.dataset.format === fmt) &&
            (!q || li.dataset.search.includes(q)),
        );
        const pages = Math.max(1, Math.ceil(matches.length / size));
        page = Math.min(page, pages);
        const from = (page - 1) * size;
        for (const li of items) li.hidden = true;
        matches.slice(from, from + size).forEach((li) => (li.hidden = false));
        status.textContent =
          matches.length === 0
            ? status.dataset.none
            : fill(root.dataset.labelCount, { total: matches.length });
        empty.hidden = matches.length > 0;
        writeAddress(playlist, lvl, fmt, query);

        pager.hidden = pages <= 1;
        if (pages <= 1) return;
        pager.querySelector('[data-pager-showing]').textContent = fill(root.dataset.labelShowing, {
          from: from + 1,
          to: Math.min(from + size, matches.length),
          total: matches.length,
        });
        const go = (n) => () => {
          page = n;
          update(true);
          // Back to the top of the grid when it has scrolled away.
          if (grid.getBoundingClientRect().top < 0) status.scrollIntoView({ block: 'start' });
        };
        pager.querySelector('[data-pager-pages]').replaceChildren(
          button(root.dataset.labelPrev, go(page - 1), { disabled: page === 1, text: '‹' }),
          ...pageList(pages).map((n) =>
            n === '…'
              ? Object.assign(document.createElement('span'), {
                  className: 'mat-gap',
                  textContent: '…',
                })
              : button(fill(root.dataset.labelPage, { n }), go(n), {
                  current: n === page,
                  text: String(n),
                }),
          ),
          button(root.dataset.labelNext, go(page + 1), { disabled: page === pages, text: '›' }),
        );
      };

      for (const r of radios) r.addEventListener('change', () => update());
      level.addEventListener('change', () => update());
      format.addEventListener('change', () => update());
      search.addEventListener('input', (event) => {
        if (!event.isComposing) update();
      });
      search.addEventListener('compositionend', () => update());
      root.querySelector('[data-lessons-clear]').addEventListener('click', () => {
        radios[0].checked = true;
        level.value = '';
        format.value = '';
        search.value = '';
        update();
        search.focus();
      });
      readAddress();
      update(true);
      window.addEventListener('pageshow', () => update(true));
    })();
  </script>
</BaseLayout>
