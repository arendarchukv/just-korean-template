---
/** Lessons library: playlists in code order; a course as a numbered table of contents, others as a grid. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import LessonCard from '@/components/LessonCard.astro';
import PageHead from '@/components/PageHead.astro';
import SectionHead from '@/components/SectionHead.astro';
import { getLessons, getPlaylists } from '@/content/queries';
import type { Lang, UIKey } from '@/i18n/ui';
import { playlistText } from '@/data/playlists';
import { localizePath, useTranslations } from '@/i18n/utils';
import { groupByPlaylist } from '@/lib/site-logic';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const groups = groupByPlaylist(await getLessons(), getPlaylists());
const href = (id: string) => localizePath(lang, `lessons/${id}`);
---

<BaseLayout title={t('page.lessons.title')}>
  <PageHead
    eyebrow={t('page.lessons.eyebrow')}
    title={t('page.lessons.title')}
    lead={t('lessons.lead')}
  />
  {groups.map((g) => {
    const id = `series-${g.playlist?.id ?? 'other'}`;
    const text = g.playlist && playlistText(g.playlist, lang);
    return (
      <section class="container-page page-section" aria-labelledby={id}>
        <SectionHead
          id={id}
          eyebrow={g.playlist ? t(`lessons.${g.playlist.kind}` as UIKey) : t('lessons.single')}
          title={text?.title ?? t('lessons.other')}
          lead={text?.description}
          link={
            g.playlist?.youtube
              ? { href: g.playlist.youtube, label: t('lessons.playlist') }
              : undefined
          }
        />
        {g.playlist?.kind === 'course' ? (
          <ol class="course-list">
            {g.lessons.map((l, i) => (
              <li>
                <a href={href(l.id)} class="course-link">
                  <span class="course-number" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="course-title">{l.title}</span>
                  {l.summary && <span class="course-summary">{l.summary}</span>}
                </a>
              </li>
            ))}
          </ol>
        ) : (
          <ul class="lesson-row">
            {g.lessons.map((l) => (
              <li>
                <LessonCard lesson={l} lang={lang} showPlaylist={false} />
              </li>
            ))}
          </ul>
        )}
      </section>
    );
  })}
</BaseLayout>
