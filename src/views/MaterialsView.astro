---
/**
 * Materials, after the logic of her old site: tabs (Class materials · Podcast · Self-study · From
 * lessons), each a dense ruled table, newest first: type · title · files · date, with a type filter
 * and a title search above, and a pager (20 rows a page) once a tab is longer than that. Without JS every tab shows one after another with its full table; the
 * inline script turns them into tabs and adds the filter.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHead from '@/components/PageHead.astro';
import { getMaterialTabs } from '@/content/queries';
import type { Lang, UIKey } from '@/i18n/ui';
import { dateFormat, localizePath, useTranslations } from '@/i18n/utils';
import type { MaterialType } from '@/lib/site-logic';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const tabs = await getMaterialTabs();
const TYPES: MaterialType[] = ['reading', 'writing', 'listening', 'vocabulary', 'video'];
const type = (k: string) => t(`materials.type.${k}` as UIKey);
const dates = dateFormat(lang);
---

<BaseLayout title={t('page.materials.title')}>
  <PageHead
    eyebrow={t('page.materials.eyebrow')}
    title={t('page.materials.title')}
    lead={t('materials.lead')}
  />

  <div
    class="container-page materials"
    data-materials
    data-page-size="20"
    data-label-prev={t('materials.prev')}
    data-label-next={t('materials.next')}
    data-label-page={t('materials.page')}
    data-label-showing={t('materials.showing')}
  >
    <div class="mat-tabs" role="tablist" aria-label={t('page.materials.title')} hidden>
      {tabs.map((tab, i) => (
        <button
          type="button"
          role="tab"
          id={`mat-tab-${tab.id}`}
          aria-controls={`mat-${tab.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          class="mat-tab"
        >
          {t(`materials.tab.${tab.id}` as UIKey)}
          <span class="mat-tab-count">{tab.items.length}</span>
        </button>
      ))}
    </div>

    <div class="mat-tools" data-mat-tools hidden>
      <label class="mat-tool">
        <span class="sr-only">{t('materials.filterType')}</span>
        <select class="field" data-mat-type>
          <option value="">{t('materials.allTypes')}</option>
          {TYPES.map((k) => (
            <option value={k}>{type(k)}</option>
          ))}
        </select>
      </label>
      <label class="mat-tool mat-search">
        <span class="sr-only">{t('materials.search')}</span>
        <input
          type="search"
          class="field"
          placeholder={t('materials.search')}
          autocomplete="off"
          data-mat-search
        />
      </label>
      <p role="status" class="mat-status" data-mat-status data-none={t('materials.noResults')}></p>
    </div>

    {tabs.map((tab) => (
      <section
        id={`mat-${tab.id}`}
        class="mat-panel"
        data-mat-panel
        aria-labelledby={`mat-title-${tab.id}`}
      >
        <h2 id={`mat-title-${tab.id}`} class="page-section-title mat-panel-title">
          {t(`materials.tab.${tab.id}` as UIKey)}
        </h2>
        <table class="mat-table">
          <thead>
            <tr>
              <th scope="col">{t('materials.col.type')}</th>
              <th scope="col">{t('materials.col.title')}</th>
              <th scope="col">{t('materials.col.files')}</th>
              <th scope="col">{t('materials.col.date')}</th>
            </tr>
          </thead>
          <tbody>
            {tab.items.map((item) => (
              <tr data-mat-row data-type={item.type ?? ''} data-search={item.title.toLowerCase()}>
                <td class="mat-type">
                  <span class="mat-badge">
                    {item.type ? type(item.type) : t('materials.type.lesson')}
                  </span>
                </td>
                <th scope="row" class="mat-title">
                  {item.lesson ? (
                    <a class="link" href={localizePath(lang, `lessons/${item.lesson.id}`)}>
                      {item.title}
                    </a>
                  ) : (
                    item.title
                  )}
                </th>
                <td>
                  <ul class="mat-files">
                    {item.files.map((f) => (
                      <li>
                        <a class="mat-file" href={f.url} target="_blank" rel="noopener noreferrer">
                          <span class="file-kind">{t(`lesson.kind.${f.kind}` as UIKey)}</span>
                          <span>{f.label}</span>
                          {/* Unique link names in a screen reader's list of links. */}
                          <span class="sr-only">: {item.title}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </td>
                <td class="mat-date">
                  <time datetime={item.date.toISOString().slice(0, 10)}>
                    {dates.format(item.date)}
                  </time>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        <nav class="mat-pager" data-mat-pager aria-label={t('materials.pages')} hidden>
          <p class="mat-pager-status" data-mat-showing></p>
          <div class="mat-pager-buttons" data-mat-pages></div>
        </nav>
      </section>
    ))}
  </div>

  <script is:inline>
    (() => {
      const root = document.querySelector('[data-materials]');
      if (!root) return;
      const tablist = root.querySelector('[role="tablist"]');
      const tabs = [...root.querySelectorAll('[role="tab"]')];
      const panels = [...root.querySelectorAll('[data-mat-panel]')];
      const tools = root.querySelector('[data-mat-tools]');
      const typeSelect = root.querySelector('[data-mat-type]');
      const search = root.querySelector('[data-mat-search]');
      const status = root.querySelector('[data-mat-status]');
      root.classList.add('is-tabbed');
      tablist.hidden = false;
      tools.hidden = false;

      let current = tabs[0];
      let page = 1;
      const size = Number(root.dataset.pageSize) || 20;
      const fill = (text, values) => text.replace(/\{(\w+)\}/g, (_, k) => String(values[k]));
      const button = (label, onClick, { current: isCurrent, disabled, text } = {}) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'mat-page';
        b.textContent = text ?? label;
        b.setAttribute('aria-label', label);
        if (isCurrent) b.setAttribute('aria-current', 'page');
        b.disabled = Boolean(disabled);
        b.addEventListener('click', onClick);
        return b;
      };
      /** Page numbers to show: all when few, else first, last and the ones around the current. */
      const pageList = (count) => {
        if (count <= 7) return Array.from({ length: count }, (_, i) => i + 1);
        const keep = new Set([1, count, page - 1, page, page + 1]);
        const list = [];
        for (let n = 1; n <= count; n++) {
          if (keep.has(n)) list.push(n);
          else if (list.at(-1) !== '…') list.push('…');
        }
        return list;
      };
      // Filter and search narrow the open tab; the pager then splits what is left.
      const filter = (keepPage = false) => {
        if (!keepPage) page = 1;
        const type = typeSelect.value;
        const q = search.value.trim().toLowerCase();
        const panel = document.getElementById(current.getAttribute('aria-controls'));
        const rows = [...panel.querySelectorAll('[data-mat-row]')];
        const matches = rows.filter(
          (row) => (!type || row.dataset.type === type) && (!q || row.dataset.search.includes(q)),
        );
        const pages = Math.max(1, Math.ceil(matches.length / size));
        page = Math.min(page, pages);
        const from = (page - 1) * size;
        for (const row of rows) row.hidden = true;
        matches.slice(from, from + size).forEach((row) => (row.hidden = false));
        status.textContent = matches.length === 0 ? status.dataset.none : '';

        const pager = panel.querySelector('[data-mat-pager]');
        pager.hidden = pages <= 1;
        if (pages <= 1) return;
        pager.querySelector('[data-mat-showing]').textContent = fill(root.dataset.labelShowing, {
          from: from + 1,
          to: Math.min(from + size, matches.length),
          total: matches.length,
        });
        const go = (n) => () => {
          page = n;
          filter(true);
          // Back to the top of the table when it has scrolled away.
          if (panel.getBoundingClientRect().top < 0) panel.scrollIntoView({ block: 'start' });
        };
        const box = pager.querySelector('[data-mat-pages]');
        box.replaceChildren(
          button(root.dataset.labelPrev, go(page - 1), { disabled: page === 1, text: '‹' }),
          ...pageList(pages).map((n) =>
            n === '…'
              ? Object.assign(document.createElement('span'), {
                  className: 'mat-gap',
                  textContent: '…',
                })
              : button(fill(root.dataset.labelPage, { n }), go(n), {
                  current: n === page,
                  text: String(n),
                }),
          ),
          button(root.dataset.labelNext, go(page + 1), { disabled: page === pages, text: '›' }),
        );
      };
      const select = (tab, focus) => {
        current = tab;
        for (const t of tabs) {
          const on = t === tab;
          t.setAttribute('aria-selected', String(on));
          t.tabIndex = on ? 0 : -1;
          document.getElementById(t.getAttribute('aria-controls')).hidden = !on;
        }
        if (focus) tab.focus();
        filter();
      };
      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => {
          select(tab, false);
          history.replaceState(null, '', `#${tab.getAttribute('aria-controls')}`);
        });
        tab.addEventListener('keydown', (event) => {
          const step = { ArrowRight: 1, ArrowLeft: -1 }[event.key];
          if (step) select(tabs[(i + step + tabs.length) % tabs.length], true);
          else if (event.key === 'Home') select(tabs[0], true);
          else if (event.key === 'End') select(tabs[tabs.length - 1], true);
          else return;
          event.preventDefault();
        });
      });
      typeSelect.addEventListener('change', () => filter());
      search.addEventListener('input', (event) => {
        if (!event.isComposing) filter();
      });
      search.addEventListener('compositionend', () => filter());
      // Open the tab named in the address (#mat-podcast), e.g. from a shared link.
      const fromHash = tabs.find((t) => `#${t.getAttribute('aria-controls')}` === location.hash);
      select(fromHash ?? tabs[0], false);
      for (const p of panels) {
        p.setAttribute('role', 'tabpanel');
        p.setAttribute('aria-labelledby', `mat-tab-${p.id.replace(/^mat-/, '')}`);
      }
      window.addEventListener('pageshow', () => filter());
    })();
  </script>
</BaseLayout>
