---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Collage from '@/components/shapes/Collage.astro';
import type { Lang, UIKey } from '@/i18n/ui';
import { localizePath, useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
// The main sections, so a broken link still leads somewhere useful.
const SECTIONS: { path: string; label: UIKey }[] = [
  { path: 'lessons', label: 'nav.lessons' },
  { path: 'grammar', label: 'page.grammar.title' },
  { path: 'practice', label: 'nav.practice' },
  { path: 'materials', label: 'nav.materials' },
];
---

<BaseLayout title={t('notFound.title')} noindex>
  <section class="container-page grid items-center gap-10 py-20 md:grid-cols-[1.4fr_1fr] md:py-28">
    <div>
      <p class="eyebrow mb-4">404</p>
      <h1 class="text-3xl font-bold tracking-tight md:text-4xl">{t('notFound.title')}</h1>
      <p class="mt-6 max-w-xl text-lg text-muted">{t('notFound.body')}</p>
      <a href={localizePath(lang)} class="btn btn-primary mt-10">
        {t('placeholder.backHome')}
      </a>
      <nav class="not-found-links" aria-labelledby="not-found-links">
        <h2 id="not-found-links" class="not-found-links-title">
          {t('notFound.try')}
        </h2>
        <ul data-not-found-links>
          {SECTIONS.map(({ path, label }) => (
            <li>
              <a href={localizePath(lang, path)} class="link">
                {t(label)}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
    <Collage variant="compact" class="mx-auto max-w-56 md:max-w-xs" />
  </section>
</BaseLayout>
