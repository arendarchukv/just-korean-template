---
/** Practice: the Flashcards and Quizzes studios, and the TOPIK mock test announced as coming soon. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHead from '@/components/PageHead.astro';
import Icon, { type IconName } from '@/components/Icon.astro';
import { getDecks, getQuizzes } from '@/content/queries';
import type { Lang, UIKey } from '@/i18n/ui';
import { localizePath, useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const decks = await getDecks();
const quizzes = await getQuizzes();
// Two ways in: the Flashcards and Quizzes studios (each lists every deck or quiz).
const ENTRIES = [
  {
    path: 'flashcards',
    icon: 'cards',
    title: 'practice.decks',
    text: 'practice.decksText',
    countKey: 'practice.decksCount',
    count: decks.length,
  },
  {
    path: 'quizzes',
    icon: 'quiz',
    title: 'practice.quizzes',
    text: 'practice.quizzesText',
    countKey: 'practice.quizzesCount',
    count: quizzes.length,
  },
] as const satisfies readonly {
  path: string;
  icon: IconName;
  title: UIKey;
  text: UIKey;
  countKey: UIKey;
  count: number;
}[];
---

<BaseLayout title={t('page.practice.title')}>
  <PageHead
    eyebrow={t('page.practice.eyebrow')}
    title={t('page.practice.title')}
    lead={t('practice.lead')}
  />

  <div class="container-page practice-entries">
    {ENTRIES.filter((e) => e.count > 0).map((e) => (
      <a class="practice-entry" href={localizePath(lang, `practice/${e.path}`)}>
        <span class="tool-icon">
          <Icon name={e.icon} />
        </span>
        <span class="practice-entry-title">{t(e.title)}</span>
        <span class="practice-entry-text">{t(e.text)}</span>
        <span class="practice-entry-foot">
          <span>{t(e.countKey).replace('{n}', String(e.count))}</span>
          <span class="practice-entry-open" aria-hidden="true">
            {t('practice.open')} →
          </span>
        </span>
      </a>
    ))}
    <!-- Announced, not built yet: muted and not a link. -->
    <div class="practice-entry practice-soon" data-coming-soon>
      <span class="tool-icon">
        <Icon name="topik" />
      </span>
      <span class="practice-entry-title">
        {t('practice.topik')}
        <span class="soon-badge">{t('practice.soon')}</span>
      </span>
      <span class="practice-entry-text">{t('practice.topikText')}</span>
    </div>
  </div>
</BaseLayout>
