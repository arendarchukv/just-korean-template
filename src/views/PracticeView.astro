---
/** Practice: links to deck and quiz pages, krdict search, pronunciation practice and lessons. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHead from '@/components/PageHead.astro';
import Icon, { type IconName } from '@/components/Icon.astro';
import { getDecks, getPlaylists, getQuizzes } from '@/content/queries';
import type { Lang, UIKey } from '@/i18n/ui';
import { localizePath, useTranslations } from '@/i18n/utils';
import { KRDICT } from '@/lib/site-logic';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const decks = await getDecks();
const quizzes = await getQuizzes();
// The pronunciation lessons, once a playlist with the id "pronunciation" is added in code.
const pronunciation = getPlaylists().find((p) => (p.id as string) === 'pronunciation');
// Two ways in: the Flashcards and Quizzes studios (each lists every deck or quiz).
const ENTRIES = [
  {
    path: 'flashcards',
    icon: 'cards',
    title: 'practice.decks',
    text: 'practice.decksText',
    countKey: 'practice.decksCount',
    count: decks.length,
  },
  {
    path: 'quizzes',
    icon: 'quiz',
    title: 'practice.quizzes',
    text: 'practice.quizzesText',
    countKey: 'practice.quizzesCount',
    count: quizzes.length,
  },
] as const satisfies readonly {
  path: string;
  icon: IconName;
  title: UIKey;
  text: UIKey;
  countKey: UIKey;
  count: number;
}[];
---

<BaseLayout title={t('page.practice.title')}>
  <PageHead
    eyebrow={t('page.practice.eyebrow')}
    title={t('page.practice.title')}
    lead={t('practice.lead')}
  />

  <div class="container-page practice-entries">
    {ENTRIES.filter((e) => e.count > 0).map((e) => (
      <a class="practice-entry" href={localizePath(lang, `practice/${e.path}`)}>
        <span class="tool-icon">
          <Icon name={e.icon} />
        </span>
        <span class="practice-entry-title">{t(e.title)}</span>
        <span class="practice-entry-text">{t(e.text)}</span>
        <span class="practice-entry-foot">
          <span>{t(e.countKey).replace('{n}', String(e.count))}</span>
          <span class="practice-entry-open" aria-hidden="true">
            {t('practice.open')} →
          </span>
        </span>
      </a>
    ))}
  </div>

  <div class="container-page practice-grid">
    <section class="practice-block practice-tool grid-paper" aria-labelledby="dictionary-title">
      <h2 id="dictionary-title" class="page-section-title">
        {t('practice.dictionary')}
      </h2>
      <p class="page-section-lead">{t('practice.dictionaryHint')}</p>
      <form class="dictionary-form" action={KRDICT.action} method="get" target="_blank">
        {Object.entries(KRDICT.hidden).map(([name, value]) => (
          <input type="hidden" name={name} value={value} />
        ))}
        <label for="dict-q" class="sr-only">
          {t('practice.dictionaryField')}
        </label>
        <input
          id="dict-q"
          class="field"
          type="search"
          name={KRDICT.field}
          lang="ko"
          required
          placeholder="사랑"
        />
        <button type="submit" class="btn btn-primary">
          {t('practice.dictionaryGo')}
        </button>
      </form>
    </section>
    <section class="practice-block practice-tool" aria-labelledby="pron-title">
      <h2 id="pron-title" class="page-section-title">
        {t('practice.pronunciation')}
      </h2>
      <p class="page-section-lead">{t('practice.pronunciationBody')}</p>
      <a
        class="btn btn-ghost"
        href="https://nuri.iksi.or.kr/"
        target="_blank"
        rel="noopener noreferrer"
      >
        {t('practice.pronunciationLink')}
      </a>
      {pronunciation && (
        <a class="btn btn-link" href={`${localizePath(lang, 'lessons')}#series-pronunciation`}>
          {t('practice.pronunciationLessons')}
        </a>
      )}
    </section>
  </div>
</BaseLayout>
