---
import LevelBadge from '@/components/learn/LevelBadge.astro';
/** One quiz in the practice studio: every quiz listed on the left, this one open. */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Quiz from '@/components/widgets/Quiz.svelte';
import { getQuizzes } from '@/content/queries';
import PracticeStudio from '@/components/PracticeStudio.astro';
import type { Lang, UIKey } from '@/i18n/ui';
import { localizePath, useTranslations } from '@/i18n/utils';

type QuizEntry = Awaited<ReturnType<typeof getQuizzes>>[number];
interface Props {
  lang: Lang;
  quiz: QuizEntry;
}

const { lang, quiz } = Astro.props;
const t = useTranslations(lang);
const quizzes = await getQuizzes();
const labels = {
  position: t('quiz.position'),
  yourAnswer: t('quiz.yourAnswer'),
  check: t('quiz.check'),
  correct: t('quiz.correct'),
  wrong: t('quiz.wrong'),
  expected: t('quiz.expected'),
  next: t('quiz.next'),
  seeResult: t('quiz.seeResult'),
  result: t('quiz.result'),
  best: t('quiz.best'),
  again: t('quiz.again'),
};
---

<BaseLayout title={quiz.title}>
  <PracticeStudio
    kind="quiz"
    units={quizzes.map((q) => ({
      ...q,
      count: q.questions.length,
      search: [
        q.title,
        ...q.questions.map((x) => (x.type === 'choice' ? x.prompt : x.sentence)),
      ].join(' '),
    }))}
    currentId={quiz.id}
    lang={lang}
  >
    <div class="studio-head">
      <p class="studio-crumb">
        <a class="link" href={localizePath(lang, 'practice')}>
          {t('page.practice.title')}
        </a>{' '}
        · {t('practice.quizzes')}
      </p>
      <p class="studio-badge-line">
        <LevelBadge level={quiz.level} label={t(`grammar.level.${quiz.level}` as UIKey)} />
        <span class="badge">
          {quiz.questions.length} {t('lesson.questions')}
        </span>
      </p>
      <h1 class="studio-title">{quiz.title}</h1>
      {quiz.lessonEntry && (
        <p class="widget-lesson">
          {t('widget.fromLesson')}{' '}
          <a class="link" href={localizePath(lang, `lessons/${quiz.lessonEntry.id}`)}>
            {quiz.lessonEntry.title}
          </a>
        </p>
      )}
    </div>
    <Quiz client:visible quizId={quiz.id} questions={quiz.questions} labels={labels} />
    <noscript>
      <!-- Without JS the widget cannot work: show only the readable list. -->
      <style>
        .widget {
          display: none;
        }
      </style>
      <ol class="widget-fallback">
        {quiz.questions.map((q) => (
          <li lang="ko">
            {q.type === 'choice'
              ? `${q.prompt} (${q.options.map((o) => o.text).join(' / ')})`
              : q.sentence}
          </li>
        ))}
      </ol>
    </noscript>
  </PracticeStudio>
</BaseLayout>
