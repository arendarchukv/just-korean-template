---
/**
 * DEMO ONLY — "Design system" tab of Site info: the "Paper & cut-outs" styleguide (it used to live
 * at /styleguide). English-only sample copy, exempt from the i18n dictionary rule.
 */
import ColorsSection from '@/components/styleguide/ColorsSection.astro';
import ControlsSection from '@/components/styleguide/ControlsSection.astro';
import LongformSection from '@/components/styleguide/LongformSection.astro';
import PatternsSection from '@/components/styleguide/PatternsSection.astro';
import ShapesSection from '@/components/styleguide/ShapesSection.astro';
import TypeSection from '@/components/styleguide/TypeSection.astro';
import SiteInfoLayout from './SiteInfoLayout.astro';

const NAV = [
  ['colors', 'Color'],
  ['type', 'Typography'],
  ['controls', 'Controls'],
  ['patterns', 'Learning patterns'],
  ['longform', 'Long-form'],
  ['shapes', 'Shapes & logo'],
] as const;
---

<SiteInfoLayout tab="design" title="Site info: design system">
  <div class="container-page pb-6">
    <p class="eyebrow">Design system</p>
    <h2 class="mt-2 text-3xl font-bold tracking-tight md:text-4xl">Paper &amp; cut-outs</h2>
    <p class="mt-4 max-w-2xl text-lg text-muted">
      Calm academic precision with one hand-made layer from the channel intro.
    </p>
    <nav aria-label="Design system sections" class="mt-8 flex flex-wrap gap-x-5 gap-y-2">
      {NAV.map(([id, label]) => (
        <a href={`#${id}`} class="link">
          {label}
        </a>
      ))}
    </nav>
  </div>
  <div class="container-page">
    <ColorsSection />
    <TypeSection />
    <ControlsSection />
    <PatternsSection />
    <LongformSection />
    <ShapesSection />
  </div>
</SiteInfoLayout>
