---
/** DEMO ONLY — the fields of a Pages CMS form, as she sees them; groups and blocks nest. */
import type { CmsField } from '@/lib/cms-forms';

interface Props {
  fields: CmsField[];
}
const { fields } = Astro.props;
---

<ul class="cms-fields">
  {fields.map((f) => (
    <li>
      <div class="cms-field-head">
        <span class="cms-field-label">{f.label}</span>
        <span class="cms-field-type">
          {f.type}
          {f.list && ' · repeatable'}
        </span>
        {f.required && <span class="cms-required">required</span>}
      </div>
      {f.hint && <p class="cms-field-hint">{f.hint}</p>}
      {f.options.length > 0 && <p class="cms-field-options">{f.options.join(' · ')}</p>}
      {f.children.length > 0 && <Astro.self fields={f.children} />}
    </li>
  ))}
</ul>
