{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "just-korean",
  "compatibility_date": "2026-10-01",
  // Static assets only: no Worker script. Astro builds into ./dist.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
}
